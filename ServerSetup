-- ServerSetup.lua — Place in ServerScriptService as a Script
-- Creates all RemoteEvents, runtime state, and handles game logic
-- NOTE: Player data (Instances + DataStore) is handled by PlayerDataHandler.lua

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- ==========================================
-- 1. CREATE ALL REMOTE EVENTS
-- ==========================================
local remoteEventNames = {
	"CombatUpdateEvent",
	"CombatActionEvent",
	"UpgradeStatEvent",
	"RollGachaEvent",
	"ChangeTaskEvent",
	"TrainEvent",
	"StartCombatEvent",
	"EquipMoveEvent",
	"EquipGearEvent",
	"PatrolEvent",
	"ShopPurchaseEvent",
	"JoinRaidEvent",
	"RebirthEvent",
}

local remotes = {}
for _, name in ipairs(remoteEventNames) do
	local existing = ReplicatedStorage:FindFirstChild(name)
	if existing then
		remotes[name] = existing
	else
		local re = Instance.new("RemoteEvent")
		re.Name = name
		re.Parent = ReplicatedStorage
		remotes[name] = re
	end
end


-- NOTE: Gacha pools, rollRarity, rollGachaItem, UpgradeStatEvent handler,
-- and RollGachaEvent handler are ALL in GachaServer.lua. No duplicates here.

-- ==========================================
-- 3. AFK REWARD RATES (Coins/XP per tick)
-- ==========================================
local AFK_TICK_INTERVAL = 6 -- seconds between rewards

local HustleRewards = {
	["Cleaning Beach"] = 10,
	["Campus Patrol"]  = 50,
	["Agency Desk"]    = 200,
	["TV Commercial"]  = 800,
	["Night Patrol"]   = 2500,
}

local TrainingRewards = {
	["Community Gym"]    = 15,
	["U.A. Gym Gamma"]   = 75,
	["U.S.J. Fire Zone"] = 300,
	["Sports Fest Ring"] = 1200,
	["Gran Torino's Apt"] = 4000,
}

-- ==========================================
-- 4. RUNTIME DATA (server-memory only, not persisted)
-- ==========================================
local playerData = {} -- [player] = {lastAFKTick, inCombat, combatZone}

local function initRuntimeData(player)
	-- Wait for PlayerDataHandler to create the data
	local stats = player:WaitForChild("PlayerStats", 15)
	if not stats then
		warn("[HeroicIdle] PlayerStats not found for " .. player.Name)
		return
	end

	playerData[player] = {
		lastAFKTick = os.clock(),
		inCombat = false,
		combatZone = nil,
	}

	print("[HeroicIdle] Runtime data initialized for: " .. player.Name)
end

local function cleanupPlayerData(player)
	playerData[player] = nil
end

Players.PlayerAdded:Connect(initRuntimeData)
Players.PlayerRemoving:Connect(cleanupPlayerData)

-- Setup for any players already in the server (Studio testing)
for _, player in ipairs(Players:GetPlayers()) do
	if not playerData[player] then
		task.spawn(function()
			initRuntimeData(player)
		end)
	end
end

-- ==========================================
-- 5. AFK TICK SYSTEM (Dual-AFK enforced)
-- ==========================================
task.spawn(function()
	while true do
		task.wait(AFK_TICK_INTERVAL)

		for _, player in ipairs(Players:GetPlayers()) do
			local stats = player:FindFirstChild("PlayerStats")
			if not stats then continue end

			local activeTaskVal = stats:FindFirstChild("ActiveTask")
			if not activeTaskVal or activeTaskVal.Value == "None" then continue end

			local taskName = activeTaskVal.Value
			local rebirthCount = 0
			local rb = player:FindFirstChild("leaderstats")
			if rb then
				local rv = rb:FindFirstChild("Rebirths")
				if rv then rebirthCount = rv.Value end
			end

			local rebirthMultiplier = 1 + (rebirthCount * 0.5) -- GDD 10.2.4: 1.5x per rebirth

			-- Side Hustle -> Hero Coins (with rebirth multiplier)
			if HustleRewards[taskName] then
				local coins = stats:FindFirstChild("HeroCoins")
				if coins then
					local reward = math.floor((HustleRewards[taskName] / 10) * rebirthMultiplier)
					coins.Value = coins.Value + reward
				end
			end

			-- Training Area -> Training XP (with rebirth multiplier)
			if TrainingRewards[taskName] then
				local xp = stats:FindFirstChild("TrainingXP")
				if xp then
					local reward = math.floor((TrainingRewards[taskName] / 10) * rebirthMultiplier)
					xp.Value = xp.Value + reward
				end
			end
		end
	end
end)

-- ==========================================
-- 6. REMOTE EVENT HANDLERS
-- ==========================================

-- NOTE: UpgradeStatEvent and RollGachaEvent are handled by GachaServer.lua.

-- CHANGE AFK TASK (Dual-AFK enforcement: one at a time)
remotes.ChangeTaskEvent.OnServerEvent:Connect(function(player, taskName)
	local stats = player:FindFirstChild("PlayerStats")
	if not stats then return end

	local activeTaskVal = stats:FindFirstChild("ActiveTask")
	if not activeTaskVal then return end

	-- Validate task name
	if taskName == "None" then
		activeTaskVal.Value = "None"
		return
	end

	if not HustleRewards[taskName] and not TrainingRewards[taskName] then
		return -- invalid task
	end

	activeTaskVal.Value = taskName
end)

-- NOTE: EquipMoveEvent, EquipGearEvent, StartCombatEvent, and CombatActionEvent
-- are ALL handled by CombatServer.lua. Do NOT add duplicate handlers here.

-- NOTE: PatrolEvent is handled by PatrolServer.lua. No duplicate handlers here.

-- SHOP PURCHASE (equips gear on purchase)
local shopPrices = {
	["Steel Gauntlets"] = 850,
	["Impact Absorber"] = 600,
	["Cooling Vents"] = 1200,
	["Homing Lens"] = 3500,
	["Titanium Blade"] = 200,
	["Padded Suit Mk.2"] = 500,
}

local shopGearTypes = {
	["Steel Gauntlets"] = "WEAPON",
	["Impact Absorber"] = "ARMOR",
	["Cooling Vents"] = "ASSIST",
	["Homing Lens"] = "ASSIST",
	["Titanium Blade"] = "WEAPON",
	["Padded Suit Mk.2"] = "ARMOR",
}

remotes.ShopPurchaseEvent.OnServerEvent:Connect(function(player, itemName)
	local stats = player:FindFirstChild("PlayerStats")
	if not stats then return end

	local heroCoins = stats:FindFirstChild("HeroCoins")
	if not heroCoins then return end

	local price = shopPrices[itemName]
	if price and heroCoins.Value >= price then
		heroCoins.Value = heroCoins.Value - price

		-- Equip the gear into the appropriate slot
		local gearType = shopGearTypes[itemName]
		if gearType then
			local gearVal = stats:FindFirstChild("Gear" .. gearType)
			if gearVal then
				gearVal.Value = itemName
			end
		end

		print("[HeroicIdle] " .. player.Name .. " purchased and equipped: " .. itemName)
	end
end)

-- JOIN RAID (follows Patrol pattern: server tells client to start combat)
remotes.JoinRaidEvent.OnServerEvent:Connect(function(player)
	local pStats = player:FindFirstChild("PlayerStats")
	if not pStats then return end

	local hz = pStats:FindFirstChild("HighestZoneCleared")
	local raidZone = tostring(math.min(5, math.max(1, (hz and hz.Value or 0) + 1)))

	-- Tell the client to initiate combat with the raid zone
	remotes.JoinRaidEvent:FireClient(player, "StartRaid", raidZone)
end)

-- REBIRTH (GDD 10.2: Reset stats, keep genetics/gear/spins, increment rebirths)
remotes.RebirthEvent.OnServerEvent:Connect(function(player)
	local stats = player:FindFirstChild("PlayerStats")
	local leaderstats = player:FindFirstChild("leaderstats")
	if not stats or not leaderstats then return end

	-- Must have cleared at least Zone 1 to rebirth
	local hz = stats:FindFirstChild("HighestZoneCleared")
	if not hz or hz.Value < 1 then return end

	-- Increment Rebirths
	leaderstats.Rebirths.Value += 1

	-- Reset stats to 1
	for _, statName in ipairs({"Strength", "Agility", "Endurance", "Intelligence", "QuirkFactor"}) do
		local s = stats:FindFirstChild(statName)
		if s then s.Value = 1 end
	end

	-- Reduce coins by 50%
	local coins = stats:FindFirstChild("HeroCoins")
	if coins then coins.Value = math.floor(coins.Value * 0.5) end

	-- Reset Training XP
	local xp = stats:FindFirstChild("TrainingXP")
	if xp then xp.Value = 0 end

	-- Reset zone progression
	hz.Value = 0

	-- Reset active task
	local at = stats:FindFirstChild("ActiveTask")
	if at then at.Value = "None" end

	-- KEEP: Spins, CurrentQuirk, CurrentTrait, CurrentStyle, Gear, Moves

	print("[HeroicIdle] " .. player.Name .. " rebirthed! Total: " .. leaderstats.Rebirths.Value)
end)

-- ==========================================
-- 7. PATROL STAMINA REGENERATION (GDD 8.2: 1 per 3 min)
-- ==========================================
task.spawn(function()
	while true do
		task.wait(180) -- 3 minutes
		for _, player in ipairs(Players:GetPlayers()) do
			local stats = player:FindFirstChild("PlayerStats")
			if stats then
				local stamina = stats:FindFirstChild("PatrolStamina")
				if stamina and stamina.Value < 100 then
					stamina.Value = math.min(100, stamina.Value + 1)
				end
			end
		end
	end
end)

print("[HeroicIdle] Server setup complete. All RemoteEvents and systems initialized.")
