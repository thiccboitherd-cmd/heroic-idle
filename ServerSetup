-- ==========================================
-- 4. PLAYER DATA SETUP
-- ==========================================
local playerData = {} -- [player] = {lastAFKTick, combatState, patrolState, ...}

local function setupPlayerData(player)
	-- leaderstats
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local rebirths = Instance.new("IntValue", leaderstats)
	rebirths.Name = "Rebirths"
	rebirths.Value = 0

	-- PlayerStats folder
	local stats = Instance.new("Folder")
	stats.Name = "PlayerStats"
	stats.Parent = player

	-- Currency
	local heroCoins = Instance.new("IntValue", stats)
	heroCoins.Name = "HeroCoins"
	heroCoins.Value = 500

	local trainingXP = Instance.new("IntValue", stats)
	trainingXP.Name = "TrainingXP"
	trainingXP.Value = 100

	local spins = Instance.new("IntValue", stats)
	spins.Name = "Spins"
	spins.Value = 5

	-- Core Stats (GDD 3.2)
	local statNames = {"Strength", "Agility", "Endurance", "Intelligence", "QuirkFactor"}
	for _, statName in ipairs(statNames) do
		local val = Instance.new("IntValue", stats)
		val.Name = statName
		val.Value = 1
	end

	-- Gacha results
	local currentQuirk = Instance.new("StringValue", stats)
	currentQuirk.Name = "CurrentQuirk"
	currentQuirk.Value = "None"

	local currentTrait = Instance.new("StringValue", stats)
	currentTrait.Name = "CurrentTrait"
	currentTrait.Value = "None"

	local currentStyle = Instance.new("StringValue", stats)
	currentStyle.Name = "CurrentStyle"
	currentStyle.Value = "Quirkless"

	-- Active AFK task
	local activeTask = Instance.new("StringValue", stats)
	activeTask.Name = "ActiveTask"
	activeTask.Value = "None"

	-- Mastery XP trackers
	local quirkMastery = Instance.new("IntValue", stats)
	quirkMastery.Name = "QuirkMasteryXP"
	quirkMastery.Value = 0

	local styleMastery = Instance.new("IntValue", stats)
	styleMastery.Name = "StyleMasteryXP"
	styleMastery.Value = 0

	-- Patrol stamina
	local patrolStamina = Instance.new("IntValue", stats)
	patrolStamina.Name = "PatrolStamina"
	patrolStamina.Value = 100

	local patrolScore = Instance.new("IntValue", stats)
	patrolScore.Name = "PatrolScore"
	patrolScore.Value = 0

	-- Store player runtime data
	playerData[player] = {
		lastAFKTick = os.clock(),
		equippedMoves = {"Empty", "Empty", "Empty", "Empty"},
		equippedGear = {WEAPON = "None", ARMOR = "None", ASSIST = "None"},
		inCombat = false,
		combatZone = nil,
	}

	print("[HeroicIdle] Player data created for: " .. player.Name)
end

local function cleanupPlayerData(player)
	playerData[player] = nil
end

Players.PlayerAdded:Connect(setupPlayerData)
Players.PlayerRemoving:Connect(cleanupPlayerData)

-- Setup for any players already in the server (Studio testing)
for _, player in ipairs(Players:GetPlayers()) do
	if not player:FindFirstChild("PlayerStats") then
		setupPlayerData(player)
	end
end

-- ==========================================
-- 5. AFK TICK SYSTEM (Dual-AFK enforced)
-- ==========================================
task.spawn(function()
	while true do
		task.wait(AFK_TICK_INTERVAL)

		for _, player in ipairs(Players:GetPlayers()) do
			local stats = player:FindFirstChild("PlayerStats")
			if not stats then continue end

			local activeTaskVal = stats:FindFirstChild("ActiveTask")
			if not activeTaskVal or activeTaskVal.Value == "None" then continue end

			local taskName = activeTaskVal.Value
			local rebirthCount = 0
			local rb = player:FindFirstChild("leaderstats")
			if rb then
				local rv = rb:FindFirstChild("Rebirths")
				if rv then rebirthCount = rv.Value end
			end

			local xpMultiplier = 1 + (rebirthCount * 0.5) -- GDD 10.2.4: 1.5x per rebirth

			-- Side Hustle → Hero Coins
			if HustleRewards[taskName] then
				local coins = stats:FindFirstChild("HeroCoins")
				if coins then
					-- Reward is per minute, tick is every 6 seconds (10 ticks/min)
					local reward = math.floor(HustleRewards[taskName] / 10)
					coins.Value = coins.Value + reward
				end
			end

			-- Training Area → Training XP
			if TrainingRewards[taskName] then
				local xp = stats:FindFirstChild("TrainingXP")
				if xp then
					local reward = math.floor((TrainingRewards[taskName] / 10) * xpMultiplier)
					xp.Value = xp.Value + reward
				end
			end
		end
	end
end)

