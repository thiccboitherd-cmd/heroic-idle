local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local PlayerData = DataStoreService:GetDataStore("HeroicIdleData_V1")

local function setupPlayerData(player)
	-- Visible Leaderstats
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = 0
	rebirths.Parent = leaderstats

	-- Hidden Stats Folder
	local stats = Instance.new("Folder")
	stats.Name = "PlayerStats"
	stats.Parent = player

	-- Currencies
	local heroCoins = Instance.new("IntValue", stats); heroCoins.Name = "HeroCoins"
	local trainingXP = Instance.new("IntValue", stats); trainingXP.Name = "TrainingXP"
	local spins = Instance.new("IntValue", stats); spins.Name = "Spins"

	-- Attributes
	local strength = Instance.new("IntValue", stats); strength.Name = "Strength"; strength.Value = 1
	local agility = Instance.new("IntValue", stats); agility.Name = "Agility"; agility.Value = 1
	local endurance = Instance.new("IntValue", stats); endurance.Name = "Endurance"; endurance.Value = 1
	local intelligence = Instance.new("IntValue", stats); intelligence.Name = "Intelligence"; intelligence.Value = 1
	local quirkFactor = Instance.new("IntValue", stats); quirkFactor.Name = "QuirkFactor"; quirkFactor.Value = 1

	local activeTask = Instance.new("StringValue", stats)
	activeTask.Name = "ActiveTask"
	activeTask.Value = "None"

	-- Genetics
	local currentQuirk = Instance.new("StringValue", stats); currentQuirk.Name = "CurrentQuirk"; currentQuirk.Value = "None"
	local currentTrait = Instance.new("StringValue", stats); currentTrait.Name = "CurrentTrait"; currentTrait.Value = "None"
	local currentStyle = Instance.new("StringValue", stats); currentStyle.Name = "CurrentStyle"; currentStyle.Value = "None"

	-- Zone Progression
	local highestZone = Instance.new("IntValue", stats); highestZone.Name = "HighestZoneCleared"; highestZone.Value = 0

	-- Patrol
	local patrolStamina = Instance.new("IntValue", stats); patrolStamina.Name = "PatrolStamina"; patrolStamina.Value = 100
	local patrolScore = Instance.new("IntValue", stats); patrolScore.Name = "PatrolScore"; patrolScore.Value = 0

	-- Mastery XP
	local quirkMastery = Instance.new("IntValue", stats); quirkMastery.Name = "QuirkMasteryXP"; quirkMastery.Value = 0
	local styleMastery = Instance.new("IntValue", stats); styleMastery.Name = "StyleMasteryXP"; styleMastery.Value = 0

	-- Equipped Gear
	local gearWeapon = Instance.new("StringValue", stats); gearWeapon.Name = "GearWEAPON"; gearWeapon.Value = "None"
	local gearArmor = Instance.new("StringValue", stats); gearArmor.Name = "GearARMOR"; gearArmor.Value = "None"
	local gearAssist = Instance.new("StringValue", stats); gearAssist.Name = "GearASSIST"; gearAssist.Value = "None"

	-- Equipped Move Slots
	local moveSlot1 = Instance.new("StringValue", stats); moveSlot1.Name = "MoveSlot1"; moveSlot1.Value = "Empty"
	local moveSlot2 = Instance.new("StringValue", stats); moveSlot2.Name = "MoveSlot2"; moveSlot2.Value = "Empty"
	local moveSlot3 = Instance.new("StringValue", stats); moveSlot3.Name = "MoveSlot3"; moveSlot3.Value = "Empty"
	local moveSlot4 = Instance.new("StringValue", stats); moveSlot4.Name = "MoveSlot4"; moveSlot4.Value = "Empty"

	-- Load Saved Data
	local playerUserId = "Player_" .. player.UserId
	local success, data = pcall(function()
		return PlayerData:GetAsync(playerUserId)
	end)

	if success and data then
		rebirths.Value = data.Rebirths or 0
		heroCoins.Value = data.HeroCoins or 0
		trainingXP.Value = data.TrainingXP or 0
		spins.Value = data.Spins or 0

		strength.Value = data.Strength or 1
		agility.Value = data.Agility or 1
		endurance.Value = data.Endurance or 1
		intelligence.Value = data.Intelligence or 1
		quirkFactor.Value = data.QuirkFactor or 1

		activeTask.Value = data.ActiveTask or "None"

		currentQuirk.Value = data.CurrentQuirk or "None"
		currentTrait.Value = data.CurrentTrait or "None"
		currentStyle.Value = data.CurrentStyle or "None"

		highestZone.Value = data.HighestZoneCleared or 0
		patrolStamina.Value = data.PatrolStamina or 100
		patrolScore.Value = data.PatrolScore or 0

		quirkMastery.Value = data.QuirkMasteryXP or 0
		styleMastery.Value = data.StyleMasteryXP or 0

		gearWeapon.Value = data.GearWEAPON or "None"
		gearArmor.Value = data.GearARMOR or "None"
		gearAssist.Value = data.GearASSIST or "None"

		moveSlot1.Value = data.MoveSlot1 or "Empty"
		moveSlot2.Value = data.MoveSlot2 or "Empty"
		moveSlot3.Value = data.MoveSlot3 or "Empty"
		moveSlot4.Value = data.MoveSlot4 or "Empty"

		print("Data loaded for " .. player.Name)
	else
		print("New player! Created default data for " .. player.Name)
	end
end

local function savePlayerData(player)
	local playerUserId = "Player_" .. player.UserId
	local stats = player:FindFirstChild("PlayerStats")

	if stats then
		local dataToSave = {
			Rebirths = player.leaderstats.Rebirths.Value,
			HeroCoins = stats.HeroCoins.Value,
			TrainingXP = stats.TrainingXP.Value,
			Spins = stats.Spins.Value,
			Strength = stats.Strength.Value,
			Agility = stats.Agility.Value,
			Endurance = stats.Endurance.Value,
			Intelligence = stats.Intelligence.Value,
			QuirkFactor = stats.QuirkFactor.Value,
			ActiveTask = stats.ActiveTask.Value,
			CurrentQuirk = stats.CurrentQuirk.Value,
			CurrentTrait = stats.CurrentTrait.Value,
			CurrentStyle = stats.CurrentStyle.Value,
			HighestZoneCleared = stats.HighestZoneCleared.Value,
			PatrolStamina = stats.PatrolStamina.Value,
			PatrolScore = stats.PatrolScore.Value,
			QuirkMasteryXP = stats.QuirkMasteryXP.Value,
			StyleMasteryXP = stats.StyleMasteryXP.Value,
			GearWEAPON = stats.GearWEAPON.Value,
			GearARMOR = stats.GearARMOR.Value,
			GearASSIST = stats.GearASSIST.Value,
			MoveSlot1 = stats.MoveSlot1.Value,
			MoveSlot2 = stats.MoveSlot2.Value,
			MoveSlot3 = stats.MoveSlot3.Value,
			MoveSlot4 = stats.MoveSlot4.Value,
		}

		local success, errorMessage = pcall(function()
			PlayerData:SetAsync(playerUserId, dataToSave)
		end)

		if not success then
			warn("Failed to save data for " .. player.Name .. ": " .. errorMessage)
		end
	end
end

Players.PlayerAdded:Connect(setupPlayerData)
Players.PlayerRemoving:Connect(savePlayerData)

-- Studio testing save override
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		savePlayerData(player)
	end
end)
