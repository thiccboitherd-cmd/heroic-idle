-- ==========================================
-- TAB SWITCHING with Ink-Splash Transition
-- ==========================================
local function switchTab(tabName: string, skipTransition: boolean?)
	local doSwitch = function()
		for name, page in pairs(G.pages) do
			if name == tabName then
				page.Visible = true
				local s = page:FindFirstChildWhichIsA("UIScale") or Instance.new("UIScale", page)
				s.Scale = 0.97
				TweenService:Create(s, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
			else
				page.Visible = false
			end
		end

		for name, btn in pairs(G.navButtons) do
			if name == tabName then
				btn.Label.TextColor3 = PALETTE.BrightYellow
				btn.Label.Font = Enum.Font.GothamBold
				btn.Icon.TextColor3 = PALETTE.BrightYellow
				-- Move glow indicator
				activeTabGlow.Visible = true
				TweenService:Create(activeTabGlow, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
					Position = UDim2.new(0, btn.Frame.AbsolutePosition.X - bottomNavBar.AbsolutePosition.X + btn.Frame.AbsoluteSize.X/2, 0, 0),
					Size = UDim2.new(0, btn.Frame.AbsoluteSize.X, 0, 3)
				}):Play()
			else
				btn.Label.TextColor3 = PALETTE.TextMuted
				btn.Label.Font = Enum.Font.Gotham
				btn.Icon.TextColor3 = PALETTE.TextMuted
			end
		end
		G.currentTab = tabName
		if G.mapOverlay then G.mapOverlay.Visible = false end
	end

	if skipTransition or G.currentTab == "" then
		doSwitch()
	else
		playInkSplash(doSwitch)
	end
end

