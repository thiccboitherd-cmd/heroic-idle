			applyHoverEffect(card, 1.04, 12)

			local topBar = Instance.new("Frame", card); topBar.Size=UDim2.new(1,0,0,4); topBar.BackgroundColor3=crisis.color; topBar.BorderSizePixel=0; topBar.ZIndex=33

			local nameLabel = Instance.new("TextLabel", card)
			nameLabel.Size=UDim2.new(1,-10,0,36); nameLabel.Position=UDim2.new(0,5,0,10)
			nameLabel.BackgroundTransparency=1; nameLabel.Text=crisis.name; nameLabel.Font=Enum.Font.GothamBold
			nameLabel.TextSize=11; nameLabel.TextColor3=crisis.color; nameLabel.TextWrapped=true; nameLabel.TextXAlignment=Enum.TextXAlignment.Left; nameLabel.ZIndex=33

			local descLabel = Instance.new("TextLabel", card)
			descLabel.Size=UDim2.new(1,-10,0,20); descLabel.Position=UDim2.new(0,5,0,48)
			descLabel.BackgroundTransparency=1; descLabel.Text=crisis.desc; descLabel.Font=Enum.Font.Gotham
