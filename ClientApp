-- ==========================================
-- PAGE BUILDER: INVENTORY (Full QoL: tabs, mastery, locked display, equipped indicators)
-- ==========================================
local function BuildInventoryPage()
	local page = G.pages["INVENTORY"]
	if not page then
		-- Safety: create page if nav system didn't
		page = Instance.new("Frame")
		page.Name = "INVENTORYPage"
		page.Size = UDim2.new(1, 0, 1, 0)
		page.BackgroundTransparency = 1
		page.Visible = false
		page.Parent = centerContainer
		G.pages["INVENTORY"] = page
	end

	local layout = Instance.new("UIListLayout", page)
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Padding = UDim.new(0, 10)
	Instance.new("UIPadding", page).PaddingTop = UDim.new(0, 8)

	-- ─── LEFT: Gear Equip + Move Slots ───
	local leftScroll = Instance.new("ScrollingFrame", page)
	leftScroll.Size = UDim2.new(0, 340, 1, -8)
	leftScroll.BackgroundColor3 = PALETTE.PanelCard; leftScroll.BorderSizePixel = 0
	leftScroll.ScrollBarThickness = 4; leftScroll.ScrollBarImageColor3 = Color3.fromRGB(80,90,120)
	leftScroll.CanvasSize = UDim2.new(0,0,0,0); leftScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	leftScroll.ClipsDescendants = true; Instance.new("UICorner", leftScroll).CornerRadius = UDim.new(0, 8)
	local lp = Instance.new("UIPadding", leftScroll)
	lp.PaddingTop=UDim.new(0,10); lp.PaddingLeft=UDim.new(0,10); lp.PaddingRight=UDim.new(0,10); lp.PaddingBottom=UDim.new(0,10)
	local ll = Instance.new("UIListLayout", leftScroll); ll.Padding=UDim.new(0,6); ll.SortOrder=Enum.SortOrder.LayoutOrder

	-- GEAR SECTION
	local eqTitle = Instance.new("TextLabel", leftScroll)
	eqTitle.Size=UDim2.new(1,0,0,14); eqTitle.LayoutOrder=0; eqTitle.BackgroundTransparency=1
	eqTitle.Text="SUPPORT GEAR  •  SELECT SLOT"; eqTitle.TextColor3=PALETTE.UA_BlueLight
	eqTitle.Font=Enum.Font.GothamBold; eqTitle.TextSize=10; eqTitle.TextXAlignment=Enum.TextXAlignment.Left

	local slotContainer = Instance.new("Frame", leftScroll)
	slotContainer.Size=UDim2.new(1,0,0,70); slotContainer.BackgroundTransparency=1; slotContainer.LayoutOrder=1
	local slotLay = Instance.new("UIListLayout", slotContainer)
	slotLay.FillDirection=Enum.FillDirection.Horizontal; slotLay.HorizontalAlignment=Enum.HorizontalAlignment.Center; slotLay.Padding=UDim.new(0,6)

	local slotIcons = {WEAPON="⚔", ARMOR="🛡", ASSIST="🔧"}
	for _, sn in ipairs({"WEAPON","ARMOR","ASSIST"}) do
		local sb = Instance.new("TextButton", slotContainer)
		sb.Size=UDim2.new(0.31,0,1,0); sb.BackgroundColor3=PALETTE.PanelHighlight; sb.BorderSizePixel=0
		sb.Text=""; sb.AutoButtonColor=false; Instance.new("UICorner",sb).CornerRadius=UDim.new(0,6)
		applyHoverEffect(sb, 1.05, 12)
		local si=Instance.new("TextLabel",sb); si.Size=UDim2.new(1,0,0,18); si.Position=UDim2.new(0,0,0,4)
		si.BackgroundTransparency=1; si.Text=slotIcons[sn]; si.TextSize=14
		local snl=Instance.new("TextLabel",sb); snl.Size=UDim2.new(1,0,0,12); snl.Position=UDim2.new(0,0,0,20)
		snl.BackgroundTransparency=1; snl.Text=sn; snl.Font=Enum.Font.GothamBold; snl.TextSize=8; snl.TextColor3=PALETTE.UA_BlueLight
		local sd=Instance.new("TextLabel",sb); sd.Name="Desc"; sd.Size=UDim2.new(1,-4,0,26); sd.Position=UDim2.new(0,2,0,34)
		sd.BackgroundTransparency=1; sd.Text="Empty"; sd.TextColor3=PALETTE.TextMuted; sd.TextSize=8; sd.TextWrapped=true; sd.Font=Enum.Font.Gotham
		local ss=Instance.new("UIStroke",sb); ss.Thickness=2; ss.Color=PALETTE.UA_BlueLight; ss.Transparency=(sn=="WEAPON") and 0 or 1
		G.gearSlotUIs[sn] = {Btn=sb, Desc=sd, Stroke=ss}
		sb.MouseButton1Click:Connect(function()
			G.selectedGearSlot = sn
			for n,d in pairs(G.gearSlotUIs) do TweenService:Create(d.Stroke,TweenInfo.new(0.15),{Transparency=(n==sn) and 0 or 1}):Play() end
		end)
	end

	-- Gear stash
	local stTitle = Instance.new("TextLabel", leftScroll)
	stTitle.Size=UDim2.new(1,0,0,12); stTitle.LayoutOrder=2; stTitle.BackgroundTransparency=1
	stTitle.Text="GEAR STASH  •  TAP TO EQUIP"; stTitle.TextColor3=PALETTE.UA_BlueLight
	stTitle.Font=Enum.Font.GothamBold; stTitle.TextSize=9; stTitle.TextXAlignment=Enum.TextXAlignment.Left

	local gearGridFrame = Instance.new("Frame", leftScroll)
	gearGridFrame.Size=UDim2.new(1,0,0,130); gearGridFrame.BackgroundTransparency=1; gearGridFrame.LayoutOrder=3
	local gridLay = Instance.new("UIGridLayout", gearGridFrame); gridLay.CellSize=UDim2.new(0,98,0,50); gridLay.CellPadding=UDim2.new(0,5,0,5)

	local stashItems = {
		{name="Steel Pipe",stat="+15 STR",col=RarityColors.Common,type="WEAPON"},
		{name="Stun Baton",stat="+10% Stun",col=RarityColors.Rare,type="WEAPON"},
		{name="Steel Gauntlets",stat="+20 STR +5% Crit",col=RarityColors.Rare,type="WEAPON"},
		{name="Heavy Vest",stat="+50 END",col=RarityColors.Rare,type="ARMOR"},
		{name="Cooling Vents",stat="-1 CD",col=RarityColors.Uncommon,type="ASSIST"},
		{name="Homing Lens",stat="+15% Hit +5% Dmg",col=RarityColors.Epic,type="ASSIST"},
	}

	for _, item in ipairs(stashItems) do
		local ib = Instance.new("TextButton", gearGridFrame)
		ib.BackgroundColor3=PALETTE.PanelHighlight; ib.BorderSizePixel=0; ib.Text=""; ib.AutoButtonColor=false
		Instance.new("UICorner",ib).CornerRadius=UDim.new(0,5); applyHoverEffect(ib,1.06,12)
		local rb = Instance.new("Frame",ib); rb.Size=UDim2.new(1,0,0,2); rb.BackgroundColor3=item.col; rb.BorderSizePixel=0
		local il = Instance.new("TextLabel",ib); il.Size=UDim2.new(1,-4,0,16); il.Position=UDim2.new(0,2,0,4)
		il.BackgroundTransparency=1; il.Text=item.name; il.TextSize=9; il.TextColor3=item.col; il.TextWrapped=true; il.Font=Enum.Font.GothamBold
		local sl = Instance.new("TextLabel",ib); sl.Size=UDim2.new(1,0,0,12); sl.Position=UDim2.new(0,0,0,24)
		sl.BackgroundTransparency=1; sl.Text=item.stat; sl.TextSize=8; sl.TextColor3=PALETTE.TextMuted; sl.Font=Enum.Font.Gotham
		ib.MouseButton1Click:Connect(function()
			local tgt = G.gearSlotUIs[item.type]
			if tgt then tgt.Desc.Text=item.name; EquipGearEvent:FireServer(item.type,item.name); showToast("⚔ "..item.name,item.col) end
		end)
		connectTooltip(ib, item.name, getGearDescription(item.name), item.stat .. " • " .. item.type)
	end

	-- DIVIDER
	local d1 = Instance.new("Frame", leftScroll); d1.Size=UDim2.new(1,0,0,1); d1.BackgroundColor3=Color3.fromRGB(50,55,70); d1.BorderSizePixel=0; d1.LayoutOrder=4

	-- MOVE SLOTS SECTION
	local msTitle = Instance.new("TextLabel", leftScroll)
	msTitle.Size=UDim2.new(1,0,0,14); msTitle.LayoutOrder=5; msTitle.BackgroundTransparency=1
	msTitle.Text="MOVE LOADOUT  •  SELECT SLOT, THEN A MOVE →"; msTitle.TextColor3=PALETTE.VillainPurple
	msTitle.Font=Enum.Font.GothamBold; msTitle.TextSize=9; msTitle.TextXAlignment=Enum.TextXAlignment.Left

	local slotsFrame = Instance.new("Frame", leftScroll)
	slotsFrame.Size=UDim2.new(1,0,0,50); slotsFrame.BackgroundTransparency=1; slotsFrame.LayoutOrder=6
	local sfl = Instance.new("UIListLayout", slotsFrame); sfl.FillDirection=Enum.FillDirection.Horizontal; sfl.Padding=UDim.new(0,5)

	local slotStrokes = {}
	for i = 1, 4 do
		local sb = Instance.new("TextButton", slotsFrame)
		sb.Size=UDim2.new(0.24,-4,1,0); sb.BackgroundColor3=PALETTE.PanelHighlight; sb.BorderSizePixel=0
		sb.Text="SLOT "..i; sb.TextWrapped=true; sb.TextSize=9; sb.Font=Enum.Font.GothamBold
		sb.TextColor3=PALETTE.TextPrimary; sb.AutoButtonColor=false; Instance.new("UICorner",sb).CornerRadius=UDim.new(0,6)
		applyHoverEffect(sb,1.05,12)
		local ss = Instance.new("UIStroke",sb); ss.Thickness=2; ss.Color=PALETTE.UA_BlueLight; ss.Transparency=(i==1) and 0 or 1
		table.insert(slotStrokes, ss)
		local nb = Instance.new("TextLabel",sb); nb.Size=UDim2.new(0,14,0,14); nb.Position=UDim2.new(0,2,0,2)
		nb.BackgroundColor3=PALETTE.UA_BlueLight; nb.Text=tostring(i); nb.TextColor3=PALETTE.PanelBG
		nb.Font=Enum.Font.GothamBlack; nb.TextSize=9; nb.BorderSizePixel=0; Instance.new("UICorner",nb).CornerRadius=UDim.new(0,4)
		sb.MouseButton1Click:Connect(function()
			G.selectedSlotIndex = i
			for j, s in ipairs(slotStrokes) do TweenService:Create(s,TweenInfo.new(0.15),{Transparency=(j==i) and 0 or 1}):Play() end
		end)
		table.insert(G.activeSlotBtns, sb)
	end

	-- Current loadout summary
	local loadoutInfo = Instance.new("TextLabel", leftScroll)
	loadoutInfo.Size=UDim2.new(1,0,0,12); loadoutInfo.LayoutOrder=7; loadoutInfo.BackgroundTransparency=1
	loadoutInfo.Text="Tip: Equip moves from the right panel →"; loadoutInfo.TextColor3=PALETTE.TextLocked
	loadoutInfo.Font=Enum.Font.Gotham; loadoutInfo.TextSize=9; loadoutInfo.TextXAlignment=Enum.TextXAlignment.Left

	-- ─── RIGHT: Move Browser with Category Tabs ───
	local rightScroll = Instance.new("ScrollingFrame", page)
	rightScroll.Name = "MoveBrowser"
	rightScroll.Size = UDim2.new(0, 450, 1, -8)
	rightScroll.BackgroundColor3 = PALETTE.PanelCard; rightScroll.BorderSizePixel = 0
	rightScroll.ScrollBarThickness = 4; rightScroll.ScrollBarImageColor3 = Color3.fromRGB(80,90,120)
	rightScroll.CanvasSize = UDim2.new(0,0,0,0); rightScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	rightScroll.ClipsDescendants = true; Instance.new("UICorner", rightScroll).CornerRadius = UDim.new(0, 8)
	local rp = Instance.new("UIPadding", rightScroll)
	rp.PaddingTop=UDim.new(0,10); rp.PaddingLeft=UDim.new(0,10); rp.PaddingRight=UDim.new(0,10); rp.PaddingBottom=UDim.new(0,10)
	local rl = Instance.new("UIListLayout", rightScroll); rl.Padding=UDim.new(0,5); rl.SortOrder=Enum.SortOrder.LayoutOrder

	-- Category tabs: QUIRK MOVES | STYLE MOVES
	local tabFrame = Instance.new("Frame", rightScroll)
	tabFrame.Size=UDim2.new(1,0,0,28); tabFrame.BackgroundTransparency=1; tabFrame.LayoutOrder=0
	local tabLay = Instance.new("UIListLayout", tabFrame)
	tabLay.FillDirection=Enum.FillDirection.Horizontal; tabLay.HorizontalAlignment=Enum.HorizontalAlignment.Left; tabLay.Padding=UDim.new(0,6)

	local activeCategory = "Quirk"
	local quirkTabBtn, styleTabBtn

	-- Mastery XP display
	local masteryLabel = Instance.new("TextLabel", rightScroll)
	masteryLabel.Size=UDim2.new(1,0,0,14); masteryLabel.LayoutOrder=1; masteryLabel.BackgroundTransparency=1
	masteryLabel.Font=Enum.Font.GothamBold; masteryLabel.TextSize=10; masteryLabel.TextXAlignment=Enum.TextXAlignment.Left
	masteryLabel.TextColor3 = PALETTE.BrightYellow

	-- Move list container
	local moveListFrame = Instance.new("Frame", rightScroll)
	moveListFrame.Name="MoveList"; moveListFrame.Size=UDim2.new(1,0,0,0)
	moveListFrame.BackgroundTransparency=1; moveListFrame.LayoutOrder=2; moveListFrame.AutomaticSize=Enum.AutomaticSize.Y
	local mvll = Instance.new("UIListLayout", moveListFrame); mvll.Padding=UDim.new(0,4)

	local function getMasteryLevel(category)
		local xpVal = statsFolder:FindFirstChild(category.."MasteryXP")
		if not xpVal then return 1 end
		return math.floor(math.sqrt(xpVal.Value / 100)) + 1
	end

	local function loadMoves()
		-- Clear existing
		for _, c in ipairs(moveListFrame:GetChildren()) do
			if not c:IsA("UIListLayout") then c:Destroy() end
		end

		local currentQuirk = statsFolder:FindFirstChild("CurrentQuirk") and statsFolder.CurrentQuirk.Value or "None"
		local currentStyle = statsFolder:FindFirstChild("CurrentStyle") and statsFolder.CurrentStyle.Value or "None"
		local quirkLvl = getMasteryLevel("Quirk")
		local styleLvl = getMasteryLevel("Style")

		-- Update mastery label
		if activeCategory == "Quirk" then
			masteryLabel.Text = "◆ " .. currentQuirk .. "  •  Quirk Mastery Lvl " .. quirkLvl
			masteryLabel.TextColor3 = PALETTE.VillainPurple
		else
			masteryLabel.Text = "◆ " .. currentStyle .. "  •  Style Mastery Lvl " .. styleLvl
			masteryLabel.TextColor3 = PALETTE.UA_BlueLight
		end

		-- Update tab highlights
		if quirkTabBtn then
			quirkTabBtn.TextColor3 = activeCategory == "Quirk" and PALETTE.VillainPurple or PALETTE.TextMuted
			quirkTabBtn.BackgroundColor3 = activeCategory == "Quirk" and PALETTE.PanelHighlight or PALETTE.PanelCard
		end
		if styleTabBtn then
			styleTabBtn.TextColor3 = activeCategory == "Style" and PALETTE.UA_BlueLight or PALETTE.TextMuted
			styleTabBtn.BackgroundColor3 = activeCategory == "Style" and PALETTE.PanelHighlight or PALETTE.PanelCard
		end

		-- Get moves for current category
		local itemName = activeCategory == "Quirk" and currentQuirk or currentStyle
		local masteryLvl = activeCategory == "Quirk" and quirkLvl or styleLvl
		local moves = MasteryMilestones[activeCategory] and MasteryMilestones[activeCategory][itemName]

		if not moves or itemName == "None" then
			local noMoves = Instance.new("TextLabel", moveListFrame)
			noMoves.Size=UDim2.new(1,0,0,40); noMoves.BackgroundTransparency=1
			noMoves.Text = itemName == "None" and "No " .. activeCategory .. " equipped. Roll one in Training!" or "No mastery data for '" .. itemName .. "' yet."
			noMoves.TextColor3=PALETTE.TextLocked; noMoves.Font=Enum.Font.Gotham; noMoves.TextSize=11; noMoves.TextWrapped=true
			return
		end

		-- Always show basic_strike as a freebie
		if activeCategory == "Style" then
			local basicCard = Instance.new("TextButton", moveListFrame)
			basicCard.Size=UDim2.new(1,0,0,52); basicCard.BackgroundColor3=PALETTE.PanelHighlight; basicCard.BorderSizePixel=0
			basicCard.Text=""; basicCard.AutoButtonColor=false; Instance.new("UICorner",basicCard).CornerRadius=UDim.new(0,6)
			applyHoverEffect(basicCard,1.03,10)
			local bName = Instance.new("TextLabel",basicCard); bName.Size=UDim2.new(0.55,0,0,16); bName.Position=UDim2.new(0,10,0,5)
			bName.BackgroundTransparency=1; bName.Text="Basic Strike"; bName.Font=Enum.Font.GothamBold; bName.TextSize=11
			bName.TextXAlignment=Enum.TextXAlignment.Left; bName.TextColor3=PALETTE.TextPrimary
			local bDesc = Instance.new("TextLabel",basicCard); bDesc.Size=UDim2.new(0.55,0,0,12); bDesc.Position=UDim2.new(0,10,0,24)
			bDesc.BackgroundTransparency=1; bDesc.Text="100% STR. 0 CD. Always available."; bDesc.TextSize=9
			bDesc.TextXAlignment=Enum.TextXAlignment.Left; bDesc.TextColor3=PALETTE.TextMuted; bDesc.Font=Enum.Font.Gotham
			local bTag = Instance.new("TextLabel",basicCard); bTag.Size=UDim2.new(0,60,0,16); bTag.AnchorPoint=Vector2.new(1,0)
			bTag.Position=UDim2.new(1,-6,0,5); bTag.BackgroundColor3=PALETTE.HealGreen; bTag.BackgroundTransparency=0.7
			bTag.Text="FREE"; bTag.Font=Enum.Font.GothamBold; bTag.TextSize=9; bTag.TextColor3=PALETTE.HealGreen
			Instance.new("UICorner",bTag).CornerRadius=UDim.new(0,4)
			basicCard.MouseButton1Click:Connect(function()
				if G.activeSlotBtns[G.selectedSlotIndex] then
					G.activeSlotBtns[G.selectedSlotIndex].Text="Basic Strike"
				end
				EquipMoveEvent:FireServer(G.selectedSlotIndex, "basic_strike")
				showToast("✔ Basic Strike → Slot "..G.selectedSlotIndex, PALETTE.TextPrimary)
			end)
			connectTooltip(basicCard, "Basic Strike", getMoveDescription("basic_strike"), "Style • 100% STR • 0 CD • Single Target")
		end

		-- Render each mastery move
		for idx, mv in ipairs(moves) do
			local isUnlocked = masteryLvl >= mv.reqLvl
			local isQuirk = activeCategory == "Quirk"
			local accentColor = isQuirk and PALETTE.VillainPurple or PALETTE.UA_BlueLight

			local card = Instance.new("TextButton", moveListFrame)
			card.Size=UDim2.new(1,0,0,56); card.BackgroundColor3=isUnlocked and PALETTE.PanelHighlight or Color3.fromRGB(18,20,30)
			card.BorderSizePixel=0; card.Text=""; card.AutoButtonColor=false; card.Active=isUnlocked
			Instance.new("UICorner",card).CornerRadius=UDim.new(0,6)

			-- Left accent stripe
			local stripe = Instance.new("Frame",card); stripe.Size=UDim2.new(0,3,0.7,0); stripe.AnchorPoint=Vector2.new(0,0.5)
			stripe.Position=UDim2.new(0,0,0.5,0); stripe.BackgroundColor3=isUnlocked and accentColor or PALETTE.TextLocked
			stripe.BorderSizePixel=0; Instance.new("UICorner",stripe).CornerRadius=UDim.new(0,4)

			-- Move name
			local mName = Instance.new("TextLabel",card); mName.Size=UDim2.new(0.55,0,0,18); mName.Position=UDim2.new(0,12,0,4)
			mName.BackgroundTransparency=1; mName.Text=mv.name; mName.Font=Enum.Font.GothamBold; mName.TextSize=12
			mName.TextXAlignment=Enum.TextXAlignment.Left
			mName.TextColor3 = isUnlocked and (isQuirk and PALETTE.VillainPurple or PALETTE.TextPrimary) or PALETTE.TextLocked

			-- Move description
			local mDesc = Instance.new("TextLabel",card); mDesc.Size=UDim2.new(0.6,0,0,14); mDesc.Position=UDim2.new(0,12,0,24)
			mDesc.BackgroundTransparency=1; mDesc.Text=mv.desc; mDesc.TextSize=10; mDesc.TextWrapped=true
			mDesc.TextXAlignment=Enum.TextXAlignment.Left; mDesc.Font=Enum.Font.Gotham
			mDesc.TextColor3 = isUnlocked and PALETTE.TextMuted or PALETTE.TextLocked

			-- Type tag
			local typeTag = Instance.new("TextLabel",card); typeTag.Size=UDim2.new(0,50,0,14); typeTag.Position=UDim2.new(0,12,0,38)
			typeTag.BackgroundColor3=isUnlocked and accentColor or PALETTE.TextLocked; typeTag.BackgroundTransparency=0.75
			typeTag.Text=activeCategory; typeTag.Font=Enum.Font.GothamBold; typeTag.TextSize=8
			typeTag.TextColor3=isUnlocked and accentColor or PALETTE.TextLocked
			Instance.new("UICorner",typeTag).CornerRadius=UDim.new(0,3)

			-- Right side: level requirement / equip status
			if isUnlocked then
				local eqTag = Instance.new("TextLabel",card); eqTag.Size=UDim2.new(0,70,0,18); eqTag.AnchorPoint=Vector2.new(1,0)
				eqTag.Position=UDim2.new(1,-6,0,5); eqTag.BackgroundColor3=PALETTE.HealGreen; eqTag.BackgroundTransparency=0.7
				eqTag.Text="✔ Lvl "..mv.reqLvl; eqTag.Font=Enum.Font.GothamBold; eqTag.TextSize=9; eqTag.TextColor3=PALETTE.HealGreen
				Instance.new("UICorner",eqTag).CornerRadius=UDim.new(0,4)

				local equipBtn = Instance.new("TextLabel",card); equipBtn.Size=UDim2.new(0,50,0,16); equipBtn.AnchorPoint=Vector2.new(1,0)
				equipBtn.Position=UDim2.new(1,-6,0,30); equipBtn.BackgroundColor3=accentColor; equipBtn.BackgroundTransparency=0.5
				equipBtn.Text="EQUIP"; equipBtn.Font=Enum.Font.GothamBold; equipBtn.TextSize=8; equipBtn.TextColor3=PALETTE.TextPrimary
				Instance.new("UICorner",equipBtn).CornerRadius=UDim.new(0,3)

				applyHoverEffect(card,1.03,10)
				card.MouseButton1Click:Connect(function()
					if G.activeSlotBtns[G.selectedSlotIndex] then
						G.activeSlotBtns[G.selectedSlotIndex].Text = mv.name
					end
					EquipMoveEvent:FireServer(G.selectedSlotIndex, mv.id)
					showToast("✔ "..mv.name.." → Slot "..G.selectedSlotIndex, isQuirk and PALETTE.VillainPurple or PALETTE.TextPrimary)
				end)
				connectTooltip(card, mv.name, getMoveDescription(mv.id), activeCategory .. " Move • " .. mv.desc .. " • CD: varies • Mastery Lvl " .. mv.reqLvl)
			else
				-- LOCKED indicator
				local lockTag = Instance.new("TextLabel",card); lockTag.Size=UDim2.new(0,100,0,18); lockTag.AnchorPoint=Vector2.new(1,0.5)
				lockTag.Position=UDim2.new(1,-6,0.5,0); lockTag.BackgroundColor3=Color3.fromRGB(40,20,20); lockTag.BackgroundTransparency=0.5
				lockTag.Text="🔒 Mastery Lvl "..mv.reqLvl; lockTag.Font=Enum.Font.GothamBold; lockTag.TextSize=9
				lockTag.TextColor3=Color3.fromRGB(200,80,80)
				Instance.new("UICorner",lockTag).CornerRadius=UDim.new(0,4)

				-- Progress hint
				local progText = Instance.new("TextLabel",card); progText.Size=UDim2.new(0,100,0,10); progText.AnchorPoint=Vector2.new(1,0)
				progText.Position=UDim2.new(1,-6,0.5,12); progText.BackgroundTransparency=1
				progText.Text="("..masteryLvl.."/"..mv.reqLvl.." mastery)"; progText.Font=Enum.Font.Gotham; progText.TextSize=8
				progText.TextColor3=PALETTE.TextLocked; progText.TextXAlignment=Enum.TextXAlignment.Right

				connectTooltip(card, "🔒 " .. mv.name .. " (Locked)", getMoveDescription(mv.id), "Requires Mastery Lvl " .. mv.reqLvl .. " • Current: " .. masteryLvl .. " • " .. mv.desc)
			end
		end
	end

	-- Create tab buttons
	quirkTabBtn = Instance.new("TextButton", tabFrame)
	quirkTabBtn.Size=UDim2.new(0,130,1,0); quirkTabBtn.BackgroundColor3=PALETTE.PanelHighlight; quirkTabBtn.BorderSizePixel=0
	quirkTabBtn.Text="✨ QUIRK MOVES"; quirkTabBtn.Font=Enum.Font.GothamBold; quirkTabBtn.TextSize=11
	quirkTabBtn.TextColor3=PALETTE.VillainPurple; quirkTabBtn.AutoButtonColor=false
	Instance.new("UICorner",quirkTabBtn).CornerRadius=UDim.new(0,6)
	applyHoverEffect(quirkTabBtn,1.04,10)

	styleTabBtn = Instance.new("TextButton", tabFrame)
	styleTabBtn.Size=UDim2.new(0,130,1,0); styleTabBtn.BackgroundColor3=PALETTE.PanelCard; styleTabBtn.BorderSizePixel=0
	styleTabBtn.Text="⚔ STYLE MOVES"; styleTabBtn.Font=Enum.Font.GothamBold; styleTabBtn.TextSize=11
	styleTabBtn.TextColor3=PALETTE.TextMuted; styleTabBtn.AutoButtonColor=false
	Instance.new("UICorner",styleTabBtn).CornerRadius=UDim.new(0,6)
	applyHoverEffect(styleTabBtn,1.04,10)

	quirkTabBtn.MouseButton1Click:Connect(function() activeCategory="Quirk"; loadMoves() end)
	styleTabBtn.MouseButton1Click:Connect(function() activeCategory="Style"; loadMoves() end)

	-- Reload on quirk/style change
	local cq = statsFolder:FindFirstChild("CurrentQuirk")
	local cs = statsFolder:FindFirstChild("CurrentStyle")
	if cq then cq.Changed:Connect(loadMoves) end
	if cs then cs.Changed:Connect(loadMoves) end

	-- Initial load
	loadMoves()
end



