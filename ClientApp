			local statusLabel = Instance.new("TextLabel", card)
			statusLabel.Name="Status"; statusLabel.Size=UDim2.new(1,-10,0,18); statusLabel.AnchorPoint=Vector2.new(0,1); statusLabel.Position=UDim2.new(0,5,1,-8)
			statusLabel.BackgroundTransparency=1; statusLabel.Text="Click to handle"; statusLabel.Font=Enum.Font.GothamBold
			statusLabel.TextSize=10; statusLabel.TextColor3=PALETTE.TextPrimary; statusLabel.ZIndex=33

			-- QTE progress bar
			local qteBar = Instance.new("Frame", card)
			qteBar.Size=UDim2.new(0.8,0,0,6); qteBar.AnchorPoint=Vector2.new(0.5,0); qteBar.Position=UDim2.new(0.5,0,0.65,0)
			qteBar.BackgroundColor3=Color3.fromRGB(30,30,40); qteBar.BorderSizePixel=0; qteBar.ZIndex=33; qteBar.Visible=false
			Instance.new("UICorner", qteBar).CornerRadius=UDim.new(1,0)
			local qteFill = Instance.new("Frame", qteBar); qteFill.Size=UDim2.new(0,0,1,0)
			qteFill.BackgroundColor3=crisis.color; qteFill.BorderSizePixel=0; qteFill.ZIndex=34
			Instance.new("UICorner", qteFill).CornerRadius=UDim.new(1,0)

			crisisCards[i] = {card=card, status=statusLabel, qteBar=qteBar, qteFill=qteFill, crisis=crisis, active=false}

			card.MouseButton1Click:Connect(function()
				if gameOver or crisis.done then return end
				-- Check if another task is active
				local anyActive = false
				for _, cd in ipairs(crisisCards) do if cd.active then anyActive = true end end
				if anyActive then showToast("Finish current task first!", PALETTE.HeroRed); return end

				-- Start QTE sequence
				crisisCards[i].active = true
				statusLabel.Text = "IN PROGRESS..."
				qteBar.Visible = true
				local clicks = 0

				card.BackgroundColor3 = Color3.fromRGB(40,50,70)

				-- QTE: rapid clicks to complete
				local qteConn
				qteConn = card.MouseButton1Click:Connect(function()
					clicks += 1
					local progress = math.clamp(clicks / crisis.qteCount, 0, 1)
					TweenService:Create(qteFill, TweenInfo.new(0.1), {Size=UDim2.new(progress,0,1,0)}):Play()

					if clicks >= crisis.qteCount then
						qteConn:Disconnect()
						crisis.done = true; tasksCompleted += 1
						crisisCards[i].active = false
						card.BackgroundColor3 = PALETTE.HealGreen
						statusLabel.Text = "✔ RESOLVED!"; statusLabel.TextColor3 = PALETTE.HealGreen
						showToast("✔ " .. crisis.name .. " resolved!", PALETTE.HealGreen)

						if tasksCompleted >= 3 then
							gameOver = true
							PatrolEvent:FireServer("MinigameResult", {result = fuelIgnited and "success" or "perfect", score = tasksCompleted})
						end
					end
				end)
			end)
		end

		-- Timer + fuel ignition
		task.spawn(function()
			while timeLeft > 0 and not gameOver do
				mgTimer.Text = "⏱ " .. timeLeft .. "s"
				mgTimer.TextColor3 = timeLeft <= 5 and PALETTE.HeroRed or PALETTE.BrightYellow

				local elapsed = (encounter.timeLimit or 25) - timeLeft
				if elapsed >= 18 and not crises[1].done and not fuelIgnited then
					fuelIgnited = true
					crisisCards[1].card.BackgroundColor3 = Color3.fromRGB(120,30,10)
					crisisCards[1].status.Text = "💥 IGNITED!"
					crisisCards[1].status.TextColor3 = PALETTE.HeroRed
					crisisCards[1].crisis.done = true
					showToast("💥 Fuel leak ignited! Situation worsened!", PALETTE.HeroRed)
				end

				task.wait(1); timeLeft -= 1
			end
			if not gameOver then
				gameOver = true
				local result = tasksCompleted >= 3 and "perfect" or tasksCompleted >= 2 and "success" or "failure"
				PatrolEvent:FireServer("MinigameResult", {result = result, score = tasksCompleted})
			end
		end)
	end

	-- ═══════════════════════════════════════════
	-- MINIGAME 4: SPEED SORT (Help the Vendor)
	-- Items scattered on screen. Click item, then click correct bin.
	-- Faster sorting = better rewards. Wrong bin = time penalty.
	-- ═══════════════════════════════════════════
	local function runSpeedSort(encounter)
		clearMinigameArea()
		mgTitle.Text = encounter.title
		mgDesc.Text = encounter.minigameDesc or "Sort items into the correct bins!"
		minigameOverlay.Visible = true

		local timeLeft = encounter.timeLimit or 20
		local gameOver = false
		local sorted = 0
		local totalItems = encounter.targetCount or 12
		local selectedItem = nil

		-- Bins at bottom
		local bins = {
			{name="Food", icon="🍢", color=Color3.fromRGB(200,120,50), items={"Octopus","Batter","Sauce","Takoyaki"}},
			{name="Tools", icon="🔧", color=Color3.fromRGB(100,150,200), items={"Skewers","Tongs","Ladle","Pan"}},
			{name="Supplies", icon="📦", color=Color3.fromRGB(150,180,100), items={"Napkins","Bags","Cups","Plates"}},
		}

		local binFrame = Instance.new("Frame", mgArea)
		binFrame.Size=UDim2.new(1,0,0,50); binFrame.AnchorPoint=Vector2.new(0,1); binFrame.Position=UDim2.new(0,0,1,0)
		binFrame.BackgroundTransparency=1; binFrame.ZIndex=33
		local binLay = Instance.new("UIListLayout", binFrame); binLay.FillDirection=Enum.FillDirection.Horizontal
		binLay.HorizontalAlignment=Enum.HorizontalAlignment.Center; binLay.Padding=UDim.new(0,8)

		local binButtons = {}
		for i, bin in ipairs(bins) do
			local bb = Instance.new("TextButton", binFrame)
			bb.Size=UDim2.new(0.28,0,1,0); bb.BackgroundColor3=bin.color; bb.BackgroundTransparency=0.6
			bb.BorderSizePixel=0; bb.Text=bin.icon.." "..bin.name; bb.Font=Enum.Font.GothamBold
			bb.TextSize=12; bb.TextColor3=Color3.fromRGB(255,255,255); bb.AutoButtonColor=false; bb.ZIndex=34
			Instance.new("UICorner", bb).CornerRadius=UDim.new(0,6)
			applyHoverEffect(bb, 1.05, 10)
			binButtons[i] = bb

			bb.MouseButton1Click:Connect(function()
				if gameOver or not selectedItem then return end
				-- Check if item belongs to this bin
				local correct = false
				for _, itemName in ipairs(bin.items) do
					if itemName == selectedItem.name then correct = true; break end
				end

				if correct then
					sorted += 1
					selectedItem.btn:Destroy()
					showToast("✔ " .. selectedItem.name .. " → " .. bin.name .. " (" .. sorted .. "/" .. totalItems .. ")", PALETTE.HealGreen)
					selectedItem = nil
					if sorted >= totalItems then
						gameOver = true
						PatrolEvent:FireServer("MinigameResult", {result = "perfect", score = sorted})
					end
				else
					-- Wrong bin penalty
					timeLeft = math.max(1, timeLeft - 2)
					showToast("✕ Wrong bin! -2s penalty!", PALETTE.HeroRed)
					if selectedItem.btn.Parent then
						TweenService:Create(selectedItem.btn, TweenInfo.new(0.1), {BackgroundColor3=PALETTE.HeroRed}):Play()
						task.delay(0.2, function()
							if selectedItem and selectedItem.btn.Parent then
								selectedItem.btn.BackgroundColor3 = PALETTE.PanelHighlight
							end
						end)
					end
				end
			end)
		end

		-- Score display
		local sortScore = Instance.new("TextLabel", mgArea)
		sortScore.Size=UDim2.new(0.3,0,0,20); sortScore.Position=UDim2.new(0.35,0,0,4)
		sortScore.BackgroundTransparency=1; sortScore.Font=Enum.Font.GothamBold; sortScore.TextSize=14
		sortScore.TextColor3=PALETTE.BrightYellow; sortScore.ZIndex=33
		sortScore.Text = "Sorted: 0/" .. totalItems

		-- Spawn scattered items
		local allItems = {}
		for _, bin in ipairs(bins) do
			for _, item in ipairs(bin.items) do table.insert(allItems, item) end
		end
		-- Shuffle and take totalItems
		for i = #allItems, 2, -1 do
			local j = math.random(1, i)
			allItems[i], allItems[j] = allItems[j], allItems[i]
		end

		for idx = 1, math.min(totalItems, #allItems) do
			local itemName = allItems[idx]
			local itemBtn = Instance.new("TextButton", mgArea)
			itemBtn.Size=UDim2.new(0,70,0,28)
			itemBtn.Position=UDim2.new(math.random(3, 70)/100, 0, math.random(10, 65)/100, 0)
			itemBtn.BackgroundColor3=PALETTE.PanelHighlight; itemBtn.BorderSizePixel=0
			itemBtn.Text=itemName; itemBtn.Font=Enum.Font.GothamBold; itemBtn.TextSize=10
			itemBtn.TextColor3=PALETTE.TextPrimary; itemBtn.AutoButtonColor=false; itemBtn.ZIndex=33
			Instance.new("UICorner", itemBtn).CornerRadius=UDim.new(0,4)
			applyHoverEffect(itemBtn, 1.08, 15)

			local itemData = {name=itemName, btn=itemBtn}

			itemBtn.MouseButton1Click:Connect(function()
				if gameOver then return end
				-- Deselect previous
				if selectedItem and selectedItem.btn.Parent then
					selectedItem.btn.BackgroundColor3 = PALETTE.PanelHighlight
					local oldStroke = selectedItem.btn:FindFirstChildWhichIsA("UIStroke")
					if oldStroke then oldStroke:Destroy() end
				end
				selectedItem = itemData
				itemBtn.BackgroundColor3 = PALETTE.UA_BlueLight
				local selStroke = Instance.new("UIStroke", itemBtn); selStroke.Color=PALETTE.BrightYellow; selStroke.Thickness=2
			end)
		end

		-- Timer
		task.spawn(function()
			while timeLeft > 0 and not gameOver do
				mgTimer.Text = "⏱ " .. timeLeft .. "s"
				mgTimer.TextColor3 = timeLeft <= 5 and PALETTE.HeroRed or PALETTE.BrightYellow
				sortScore.Text = "Sorted: " .. sorted .. "/" .. totalItems
				task.wait(1); timeLeft -= 1
			end
			if not gameOver then
				gameOver = true
				local result = sorted >= totalItems and "perfect" or sorted >= math.floor(totalItems*0.6) and "success" or "failure"
				PatrolEvent:FireServer("MinigameResult", {result = result, score = sorted})
			end
		end)
	end

	-- ═══════════════════════════════════════════
	-- MINIGAME 5: MAZE NAVIGATE (Lost Child)
	-- Guide the child through a grid to the fountain.
	-- Fewer wrong turns = better score. Dead ends scare the child.
	-- ═══════════════════════════════════════════
	local function runMazeNavigate(encounter)
		clearMinigameArea()
		mgTitle.Text = encounter.title
		mgDesc.Text = encounter.minigameDesc or "Guide the child to the fountain!"
		mgTimer.Text = "Find the way!"; mgTimer.TextColor3 = PALETTE.BrightYellow
		minigameOverlay.Visible = true

		local gameOver = false
		local wrongTurns = 0
		local COLS, ROWS = 7, 5

		-- Generate simple maze with a clear path and some dead ends
		-- 0=wall, 1=path, 2=start, 3=goal, 4=dead end
		local maze = {}
		for r = 1, ROWS do
			maze[r] = {}
			for c = 1, COLS do maze[r][c] = 0 end
		end

		-- Carve a winding path from (1,1) to (ROWS,COLS)
		local path = {{1,1}}
		maze[1][1] = 2 -- start
		local cr, cc = 1, 1
		math.randomseed(os.clock() * 1000)
		while cr ~= ROWS or cc ~= COLS do
			local moves = {}
			if cr < ROWS then table.insert(moves, {cr+1, cc}) end
			if cc < COLS then table.insert(moves, {cr, cc+1}) end
			if cr > 1 and math.random() < 0.2 then table.insert(moves, {cr-1, cc}) end
			if cc > 1 and math.random() < 0.15 then table.insert(moves, {cr, cc-1}) end
			local next = moves[math.random(1, #moves)]
			cr, cc = next[1], next[2]
			if maze[cr][cc] == 0 then
				maze[cr][cc] = 1
				table.insert(path, {cr, cc})
			end
		end
		maze[ROWS][COLS] = 3 -- goal

		-- Add dead ends branching off the path
		for _, cell in ipairs(path) do
			local r, c = cell[1], cell[2]
			local dirs = {{-1,0},{1,0},{0,-1},{0,1}}
			for _, d in ipairs(dirs) do
				local nr, nc = r+d[1], c+d[2]
				if nr >= 1 and nr <= ROWS and nc >= 1 and nc <= COLS and maze[nr][nc] == 0 and math.random() < 0.35 then
					maze[nr][nc] = 4
				end
			end
		end

		-- Render grid
		local cellSize = math.min(50, math.floor(mgArea.AbsoluteSize.X * 0.85 / COLS))
		local gridFrame = Instance.new("Frame", mgArea)
		gridFrame.Size=UDim2.new(0, cellSize*COLS+COLS*3, 0, cellSize*ROWS+ROWS*3)
		gridFrame.AnchorPoint=Vector2.new(0.5,0.5); gridFrame.Position=UDim2.new(0.5,0,0.5,0)
		gridFrame.BackgroundTransparency=1; gridFrame.ZIndex=32
		local gridLay = Instance.new("UIGridLayout", gridFrame)
		gridLay.CellSize=UDim2.new(0,cellSize,0,cellSize); gridLay.CellPadding=UDim2.new(0,3,0,3)

		local playerPos = {1, 1}
		local cells = {}

		for r = 1, ROWS do
			cells[r] = {}
			for c = 1, COLS do
				local cellVal = maze[r][c]
				local cell = Instance.new("TextButton", gridFrame)
				cell.BackgroundColor3 = cellVal == 0 and Color3.fromRGB(25,28,38) or cellVal == 2 and PALETTE.HealGreen or cellVal == 3 and PALETTE.BrightYellow or Color3.fromRGB(45,50,65)
				cell.BorderSizePixel=0; cell.AutoButtonColor=false; cell.ZIndex=33
				cell.Text = cellVal == 2 and "👦" or cellVal == 3 and "⛲" or ""
				cell.TextSize = math.floor(cellSize * 0.6); cell.Font = Enum.Font.GothamBold
				Instance.new("UICorner", cell).CornerRadius=UDim.new(0,4)

				if cellVal == 0 then cell.Active = false end -- walls not clickable

				cells[r][c] = {btn=cell, val=cellVal}

				cell.MouseButton1Click:Connect(function()
					if gameOver or cellVal == 0 then return end
					local pr, pc = playerPos[1], playerPos[2]
					-- Must be adjacent
					local dist = math.abs(r - pr) + math.abs(c - pc)
					if dist ~= 1 then showToast("Move to an adjacent tile!", PALETTE.TextMuted); return end

					-- Move player
					cells[pr][pc].btn.Text = ""
					cells[pr][pc].btn.BackgroundColor3 = Color3.fromRGB(35,55,45) -- visited

					if cellVal == 4 then
						-- Dead end!
						wrongTurns += 1
						cell.BackgroundColor3 = PALETTE.HeroRed
						cell.Text = "😨"
						showToast("Dead end! The child is scared! (" .. wrongTurns .. " wrong turns)", PALETTE.HeroRed)
						task.delay(0.8, function()
							if cell.Parent then cell.Text = ""; cell.BackgroundColor3 = Color3.fromRGB(60,35,35) end
						end)
						-- Push back to previous position
						cells[pr][pc].btn.Text = "👦"
						return
					end

					playerPos = {r, c}
					cell.Text = "👦"
					cell.BackgroundColor3 = PALETTE.HealGreen

					if cellVal == 3 then
						-- Reached the fountain!
						gameOver = true
						cell.Text = "⛲👦"
						showToast("Found the fountain! The child is safe!", PALETTE.BrightYellow)
						local result = wrongTurns == 0 and "perfect" or wrongTurns <= 3 and "success" or "failure"
						PatrolEvent:FireServer("MinigameResult", {result = result, score = math.max(0, 10 - wrongTurns)})
					else
						-- Child comments
						local comments = {"\"Are we close?\"", "\"That dog is big!\"", "\"I see something!\"", "\"Which way?\"", "\"I'm scared...\""}
						mgTimer.Text = comments[math.random(1, #comments)]
					end
				end)
			end
		end
	end

