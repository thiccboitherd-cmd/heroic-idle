	local drift = math.random(-15, 15)
	local targetPos = UDim2.new(screenPos.X.Scale, screenPos.X.Offset + drift, screenPos.Y.Scale, screenPos.Y.Offset - 70)
	TweenService:Create(label, TweenInfo.new(fadeDur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos, TextTransparency = 1, TextStrokeTransparency = 1}):Play()
	game:GetService("Debris"):AddItem(label, fadeDur + 0.1)
