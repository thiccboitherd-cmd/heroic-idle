		crisisLayout.VerticalAlignment=Enum.VerticalAlignment.Center; crisisLayout.Padding=UDim.new(0,8)

		local crisisCards = {}
		for i, crisis in ipairs(crises) do
			local card = Instance.new("TextButton", mgArea)
