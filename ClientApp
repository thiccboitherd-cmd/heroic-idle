	-- ═══════════════════════════════════════════
	-- MINIGAME 3: PRIORITY CHOICE (Traffic Pileup)
	-- Three simultaneous crises. Player picks order. Each takes time.
	-- Fuel leak ignites if not addressed within 18s. Strategy matters!
	-- ═══════════════════════════════════════════
	local function runPriorityChoice(encounter)
		clearMinigameArea()
		mgTitle.Text = encounter.title
		mgDesc.Text = encounter.minigameDesc or "Three crises at once! Choose the right order!"
		minigameOverlay.Visible = true

		local timeLeft = encounter.timeLimit or 25
		local gameOver = false
		local tasksCompleted = 0
		local fuelIgnited = false

		local crises = {
			{name="🔥 Contain Fuel Leak", qteCount=3, urgency=18, color=PALETTE.HeroRed, desc="CRITICAL: Ignites in 18s!", done=false},
			{name="👩‍👦 Rescue Civilians", qteCount=4, urgency=99, color=PALETTE.BrightYellow, desc="Mother & child trapped", done=false},
			{name="🚗 Direct Traffic", qteCount=2, urgency=99, color=PALETTE.UA_BlueLight, desc="Clear the intersection", done=false},
