	local function updateStamina()
		local sv = statsFolder:FindFirstChild("PatrolStamina")
		if sv then
			local pct = math.clamp(sv.Value / 100, 0, 1)
			TweenService:Create(staminaFill, TweenInfo.new(0.3), {Size=UDim2.new(pct,0,1,0)}):Play()
