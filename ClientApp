	-- ═══════════════════════════════════════════
	-- MINIGAME 1: REACTION TEST (Kitten Rescue / Neighborhood Watch)
	-- Click targets that appear randomly. Combo system for engagement.
	-- ═══════════════════════════════════════════
	local function runReactionTest(encounter)
		clearMinigameArea()
		mgTitle.Text = encounter.title
		mgDesc.Text = encounter.minigameDesc or "Click the targets before they disappear!"
		minigameOverlay.Visible = true

		local targetsHit = 0
		local totalTargets = encounter.targetCount or 8
		local timeLeft = encounter.timeLimit or 15
		local gameOver = false
		local combo = 0
		local missed = 0

		-- Score display
		local scoreDisplay = Instance.new("TextLabel", mgArea)
		scoreDisplay.Size=UDim2.new(0.3,0,0,24); scoreDisplay.Position=UDim2.new(0.35,0,0,4)
		scoreDisplay.BackgroundTransparency=1; scoreDisplay.Font=Enum.Font.GothamBlack; scoreDisplay.TextSize=16
		scoreDisplay.TextColor3=PALETTE.BrightYellow; scoreDisplay.ZIndex=33
		scoreDisplay.Text = "0 / " .. totalTargets

		-- Combo display
		local comboDisplay = Instance.new("TextLabel", mgArea)
		comboDisplay.Size=UDim2.new(0.3,0,0,18); comboDisplay.AnchorPoint=Vector2.new(1,0); comboDisplay.Position=UDim2.new(1,-6,0,6)
		comboDisplay.BackgroundTransparency=1; comboDisplay.Font=Enum.Font.GothamBold; comboDisplay.TextSize=12
		comboDisplay.TextColor3=PALETTE.HealGreen; comboDisplay.ZIndex=33; comboDisplay.TextXAlignment=Enum.TextXAlignment.Right
		comboDisplay.Text = ""

		-- Timer
		task.spawn(function()
			while timeLeft > 0 and not gameOver do
				mgTimer.Text = "⏱ " .. timeLeft .. "s"
				mgTimer.TextColor3 = timeLeft <= 5 and PALETTE.HeroRed or PALETTE.BrightYellow
				task.wait(1); timeLeft -= 1
			end
			if not gameOver then
				gameOver = true
				local result = targetsHit >= totalTargets and "perfect" or targetsHit >= math.floor(totalTargets*0.6) and "success" or "failure"
				PatrolEvent:FireServer("MinigameResult", {result = result, score = targetsHit})
			end
		end)

		-- Spawn targets with variety
		local targetStyles = {
			{text="!", color=PALETTE.HeroRed, size=48, lifetime=2.8},
			{text="◆", color=PALETTE.VillainPurple, size=40, lifetime=2.2},
			{text="★", color=PALETTE.BrightYellow, size=52, lifetime=3.0},
			{text="●", color=PALETTE.UA_BlueLight, size=36, lifetime=1.8},
		}

		task.spawn(function()
			for i = 1, totalTargets do
				if gameOver then break end
				local style = targetStyles[math.random(1, #targetStyles)]
				local target = Instance.new("TextButton", mgArea)
				target.Size = UDim2.new(0, style.size, 0, style.size)
				target.Position = UDim2.new(math.random(5, 80)/100, 0, math.random(12, 80)/100, 0)
				target.BackgroundColor3 = style.color; target.Text = style.text
				target.TextColor3 = Color3.fromRGB(255,255,255); target.Font = Enum.Font.GothamBlack; target.TextSize = 18
				target.BorderSizePixel = 0; target.AutoButtonColor = false; target.ZIndex = 32
				Instance.new("UICorner", target).CornerRadius = UDim.new(1, 0)

				-- Appear animation
				local scale = Instance.new("UIScale", target); scale.Scale = 0
				TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Scale = 1}):Play()

				-- Shrink warning before disappearing
				local thisTarget = target
				task.delay(style.lifetime - 0.5, function()
					if thisTarget.Parent and not gameOver then
						TweenService:Create(thisTarget, TweenInfo.new(0.4), {BackgroundTransparency = 0.6, Size = UDim2.new(0, style.size*0.6, 0, style.size*0.6)}):Play()
					end
				end)

				target.MouseButton1Click:Connect(function()
					if gameOver then return end
					targetsHit += 1; combo += 1
					scoreDisplay.Text = targetsHit .. " / " .. totalTargets

					-- Combo feedback
					if combo >= 3 then
						comboDisplay.Text = combo .. "x COMBO!"
						comboDisplay.TextColor3 = combo >= 6 and PALETTE.BrightYellow or PALETTE.HealGreen
					else
						comboDisplay.Text = ""
					end

					-- Hit animation
					target.Text = "✔"; target.BackgroundColor3 = PALETTE.HealGreen
					TweenService:Create(target, TweenInfo.new(0.2), {Size = UDim2.new(0, style.size*1.3, 0, style.size*1.3), BackgroundTransparency = 1}):Play()
					task.delay(0.25, function() if target.Parent then target:Destroy() end end)

					showToast(combo >= 3 and (combo .. "x Combo! (" .. targetsHit .. "/" .. totalTargets .. ")") or ("Hit! " .. targetsHit .. "/" .. totalTargets), combo >= 5 and PALETTE.BrightYellow or PALETTE.HealGreen)

					if targetsHit >= totalTargets then
						gameOver = true
						PatrolEvent:FireServer("MinigameResult", {result = "perfect", score = targetsHit})
					end
				end)

				-- Miss (target disappears)
				task.delay(style.lifetime, function()
					if target.Parent and not gameOver then
						target:Destroy()
						missed += 1; combo = 0
						comboDisplay.Text = "Miss!"
						comboDisplay.TextColor3 = PALETTE.HeroRed
					end
				end)

				task.wait(math.random(8, 18) / 10)
			end
		end)
	end

