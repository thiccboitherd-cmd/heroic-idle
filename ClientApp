-- TOOLTIP SYSTEM — Hover descriptions for moves, gear, items
-- ==========================================
local tooltipFrame, tooltipTitle, tooltipDesc, tooltipStats

local function BuildTooltipFrame()
	tooltipFrame = Instance.new("Frame")
	tooltipFrame.Name = "Tooltip"
	tooltipFrame.Size = UDim2.new(0, 260, 0, 0)
	tooltipFrame.AutomaticSize = Enum.AutomaticSize.Y
	tooltipFrame.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	tooltipFrame.BorderSizePixel = 0
	tooltipFrame.Visible = false
	tooltipFrame.ZIndex = 500
	tooltipFrame.Active = false

	local corner = Instance.new("UICorner", tooltipFrame)
	corner.CornerRadius = UDim.new(0, 8)
	local stroke = Instance.new("UIStroke", tooltipFrame)
	stroke.Color = Color3.fromRGB(80, 90, 130)
	stroke.Thickness = 1
	local pad = Instance.new("UIPadding", tooltipFrame)
	pad.PaddingTop = UDim.new(0, 8); pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 10); pad.PaddingRight = UDim.new(0, 10)
	local lay = Instance.new("UIListLayout", tooltipFrame)
	lay.Padding = UDim.new(0, 4); lay.SortOrder = Enum.SortOrder.LayoutOrder

	tooltipTitle = Instance.new("TextLabel", tooltipFrame)
	tooltipTitle.Size = UDim2.new(1, 0, 0, 16)
	tooltipTitle.BackgroundTransparency = 1
	tooltipTitle.Font = Enum.Font.GothamBlack; tooltipTitle.TextSize = 12
	tooltipTitle.TextColor3 = Color3.fromRGB(255, 220, 100)
	tooltipTitle.TextXAlignment = Enum.TextXAlignment.Left
	tooltipTitle.TextWrapped = true; tooltipTitle.AutomaticSize = Enum.AutomaticSize.Y
	tooltipTitle.LayoutOrder = 1; tooltipTitle.ZIndex = 501

	tooltipStats = Instance.new("TextLabel", tooltipFrame)
	tooltipStats.Size = UDim2.new(1, 0, 0, 12)
	tooltipStats.BackgroundTransparency = 1
	tooltipStats.Font = Enum.Font.GothamBold; tooltipStats.TextSize = 10
	tooltipStats.TextColor3 = Color3.fromRGB(130, 180, 255)
	tooltipStats.TextXAlignment = Enum.TextXAlignment.Left
	tooltipStats.TextWrapped = true; tooltipStats.AutomaticSize = Enum.AutomaticSize.Y
	tooltipStats.LayoutOrder = 2; tooltipStats.ZIndex = 501

	tooltipDesc = Instance.new("TextLabel", tooltipFrame)
	tooltipDesc.Size = UDim2.new(1, 0, 0, 40)
	tooltipDesc.BackgroundTransparency = 1
	tooltipDesc.Font = Enum.Font.Gotham; tooltipDesc.TextSize = 10
	tooltipDesc.TextColor3 = Color3.fromRGB(180, 185, 200)
	tooltipDesc.TextXAlignment = Enum.TextXAlignment.Left
	tooltipDesc.TextWrapped = true; tooltipDesc.AutomaticSize = Enum.AutomaticSize.Y
	tooltipDesc.LayoutOrder = 3; tooltipDesc.ZIndex = 501
end

local function showTooltip(title, desc, statsText)
	if not tooltipFrame then return end
	tooltipTitle.Text = title or ""
	tooltipDesc.Text = desc or ""
	tooltipStats.Text = statsText or ""
	tooltipStats.Visible = (statsText ~= nil and statsText ~= "")
	tooltipFrame.Visible = true
end

local function hideTooltip()
	if tooltipFrame then tooltipFrame.Visible = false end
end

local function attachTooltipFollower()
	if not tooltipFrame then return end
	RunService.RenderStepped:Connect(function()
		if tooltipFrame.Visible then
			local mouse = game:GetService("UserInputService"):GetMouseLocation()
			local viewSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
			local xOff = (mouse.X > viewSize.X * 0.6) and -270 or 14
			local yOff = (mouse.Y > viewSize.Y * 0.7) and -120 or 14
			tooltipFrame.Position = UDim2.new(0, mouse.X + xOff, 0, mouse.Y + yOff)
		end
	end)
end

local function connectTooltip(btn, title, desc, statsText)
	btn.MouseEnter:Connect(function() showTooltip(title, desc, statsText) end)
	btn.MouseLeave:Connect(function() hideTooltip() end)
end

