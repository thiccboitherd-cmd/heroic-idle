		kt.Font = Enum.Font.GothamBold; kt.TextSize = 10
	end

	local title = UIFramework.UILabel.new("Title", btn.Gui)
	title.Gui.Size = UDim2.new(1, -30, 0, 22)
	title.Gui.Position = UDim2.new(0, 10, 0, 8)
	title:SetText(moveName)
	title.Gui.Font = Enum.Font.GothamBold; title.Gui.TextXAlignment = Enum.TextXAlignment.Left; title.Gui.TextSize = 13

	local typeLbl = UIFramework.UILabel.new("Type", btn.Gui)
	typeLbl.Gui.Size = UDim2.new(1, -20, 0, 16)
	typeLbl.Gui.Position = UDim2.new(0, 10, 0, 32)
	typeLbl:SetText("[" .. moveType .. "]")
	typeLbl.Gui.TextColor3 = typeColor
	typeLbl.Gui.TextXAlignment = Enum.TextXAlignment.Left
	typeLbl.Gui.Font = Enum.Font.GothamBold; typeLbl.Gui.TextSize = 10

	local descLbl = UIFramework.UILabel.new("Desc", btn.Gui)
	descLbl.Gui.Size = UDim2.new(1, -20, 0, 40)
	descLbl.Gui.Position = UDim2.new(0, 10, 0, 52)
	descLbl:SetText(desc)
	descLbl.Gui.TextColor3 = PALETTE.TextMuted; descLbl.Gui.TextSize = 10
	descLbl.Gui.TextWrapped = true; descLbl.Gui.TextXAlignment = Enum.TextXAlignment.Left
	descLbl.Gui.Font = Enum.Font.Gotham

	local crossOut = Instance.new("Frame", btn.Gui)
	crossOut.Size = UDim2.new(1, 0, 0, 3)
	crossOut.Position = UDim2.new(0, 0, 0.5, -1)
	crossOut.BackgroundColor3 = PALETTE.HeroRed; crossOut.Rotation = 12; crossOut.Visible = false

	local function setMoveState(state: string)
		if state == "Normal" then crossOut.Visible = false; title.Gui.TextColor3 = PALETTE.TextPrimary
		elseif state == "Erasure" and isQuirk then crossOut.Visible = true; title.Gui.TextColor3 = PALETTE.TextLocked
		end
	end

	-- Convert display name to move_id for description lookup
	local moveId = moveName:lower():gsub(" ", "_"):gsub("'", ""):gsub(":", ""):gsub("%.", ""):gsub("%-", "_")
	connectTooltip(btn.Gui, moveName, getMoveDescription(moveId), (isQuirk and "Quirk" or "Style") .. " • " .. desc)

	return { Button = btn, SetState = setMoveState }
end

-- ==========================================
-- COMBAT STATE MANAGER
-- ==========================================
local function updateCombatUI(combatState)
	-- Auto-show the COMBAT page whenever we receive combat data
	if G.currentTab ~= "COMBAT" then
		switchTab("COMBAT", true)
	end

	if not combatState.IsActive and combatState.Result then
		G.resultOverlay.Visible = true
		for _, child in ipairs(G.rewardsContainer:GetChildren()) do
			if child:IsA("TextLabel") or child:IsA("Frame") then child:Destroy() end
		end

		if combatState.Result.Type == "Victory" then
			G.resultTitle:SetText("⚡ VICTORY!")
			G.resultTitle.Gui.TextColor3 = PALETTE.BrightYellow
			G.resultDesc:SetText("Zone cleared. Rewards acquired:")
			flashSpeedLines(16, PALETTE.BrightYellow, 1)
			showToast("⚡ VICTORY!", PALETTE.BrightYellow, 4)

			for rewardName, amount in pairs(combatState.Result.Rewards) do
				local rRow = Instance.new("Frame", G.rewardsContainer)
				rRow.Size = UDim2.new(1, 0, 0, 26)
				rRow.BackgroundColor3 = Color3.fromRGB(20, 30, 20); rRow.BorderSizePixel = 0
				Instance.new("UICorner", rRow).CornerRadius = UDim.new(0, 6)
				local rLabel = Instance.new("TextLabel", rRow)
				rLabel.Size = UDim2.new(1, -16, 1, 0); rLabel.Position = UDim2.new(0, 10, 0, 0)
				rLabel.BackgroundTransparency = 1
				rLabel.Text = "+ " .. amount .. "  " .. rewardName
				rLabel.TextColor3 = PALETTE.HealGreen
				rLabel.Font = Enum.Font.GothamBold; rLabel.TextSize = 12
				rLabel.TextXAlignment = Enum.TextXAlignment.Left
			end
		else
			G.resultTitle:SetText("✕ DEFEAT")
			G.resultTitle.Gui.TextColor3 = PALETTE.HeroRed
			G.resultDesc:SetText("Train harder and retry.")
			showPanelCrack(2)
			showToast("💀 Defeated...", PALETTE.HeroRed, 4)
		end
		G.combatantCards = {}; G.selectedTargetId = nil
		return
	end

	-- Update Awakening meter
	if combatState.AwakeningPercent and G.awakeningBar then
		local pct = math.clamp(combatState.AwakeningPercent, 0, 1)
		TweenService:Create(G.awakeningBar.Fill, TweenInfo.new(0.3), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
		G.awakeningText.Text = "AWAKENING: " .. math.floor(pct * 100) .. "%"
		if pct >= 1 then
			G.awakeningBar.Glow.Transparency = 0
			G.awakeningText.Text = "✦ ULTIMATE READY ✦"
		else
			G.awakeningBar.Glow.Transparency = 1
		end
	end

	-- Clear + rebuild turn order
	for _, child in ipairs(G.turnOrderPanelGui:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("TextLabel") then child:Destroy() end
	end
	for _, cId in ipairs(combatState.TurnQueue) do
		local data = combatState.Combatants[cId]
		if data then addToTurnOrder(data.Portrait, data.IsEnemy, cId == combatState.ActiveTurn) end
	end

	local firstAliveEnemy = nil
	local isMyTurn = (combatState.ActiveTurn == player.Name)

	if G.turnIndicator then
		G.turnIndicator.Text = isMyTurn and "⚡ YOUR TURN" or "WAITING..."
		G.turnIndicator.TextColor3 = isMyTurn and PALETTE.HealGreen or PALETTE.TextLocked
	end

	for id, data in pairs(combatState.Combatants) do
		local cardData = G.combatantCards[id]
		if not cardData then
			cardData = createCombatant(data.Name, data.IsEnemy, data.MaxHP, data.Portrait, data.IsBoss)
			cardData.CurrentHP = data.HP
			G.combatantCards[id] = cardData

			if data.IsEnemy then
				local targetBtn = Instance.new("TextButton", cardData.Card)
				targetBtn.Size = UDim2.new(1, 0, 1, 0)
				targetBtn.BackgroundTransparency = 1; targetBtn.Text = ""; targetBtn.ZIndex = 5
				targetBtn.MouseButton1Click:Connect(function()
					if data.HP > 0 then
						G.selectedTargetId = id
						for eId, eCard in pairs(G.combatantCards) do
							if combatState.Combatants[eId] and combatState.Combatants[eId].IsEnemy then
								eCard.TurnStroke.Transparency = (eId == id) and 0 or 1
								eCard.TurnStroke.Color = PALETTE.HeroRed
							end
						end
					end
				end)
			end
		end

		local hpPct = math.clamp(data.HP / data.MaxHP, 0, 1)
		local prevHP = cardData.CurrentHP or data.MaxHP

		if data.HP < prevHP then
			cardData.TriggerDamage()
			local dmg = prevHP - data.HP
			if dmg > 0 and G.floatingTextLayer then
				task.spawn(function()
					RunService.RenderStepped:Wait()
					local absPos = cardData.Card.AbsolutePosition
					local absSize = cardData.Card.AbsoluteSize
					local vp = game.Workspace.CurrentCamera.ViewportSize
					local pos = UDim2.new((absPos.X + absSize.X/2) / vp.X, 0, (absPos.Y + 20) / vp.Y, 0)

					local isCrit = dmg > data.MaxHP * 0.15
					local isMassive = dmg > data.MaxHP * 0.25

					spawnFloatingText(
						(isCrit and "💥 " or "") .. "-" .. math.floor(dmg),
						isCrit and "Crit" or "Normal",
						pos
					)

					-- GDD 2.1.3: Onomatopoeia for 150%+ base damage
					if isCrit then flashSpeedLines(12, PALETTE.BrightYellow, 0.4) end
					if isMassive then
						showOnomatopoeia()
						showPanelCrack()
					end
				end)
			end
		end

		cardData.CurrentHP = data.HP
		cardData.HPBar:SetProgress(hpPct)
		if cardData.HPText then cardData.HPText:SetText(math.floor(data.HP) .. "/" .. math.floor(data.MaxHP)) end

		-- Boss phase update
		if cardData.UpdatePhase then cardData.UpdatePhase(hpPct) end

		local statusType = type(data.Status) == "table" and data.Status.Type or data.Status
		cardData.ApplyStatus(statusType or "Normal")

		if data.IsEnemy and data.HP > 0 and not firstAliveEnemy then firstAliveEnemy = id end

		if id == combatState.ActiveTurn then
			cardData.TurnStroke.Color = PALETTE.BrightYellow; cardData.TurnStroke.Transparency = 0
		elseif data.IsEnemy and id == G.selectedTargetId then
			cardData.TurnStroke.Color = PALETTE.HeroRed; cardData.TurnStroke.Transparency = 0
		else
			cardData.TurnStroke.Transparency = 1
		end
	end

	if (not G.selectedTargetId or (combatState.Combatants[G.selectedTargetId] and combatState.Combatants[G.selectedTargetId].HP <= 0)) and firstAliveEnemy then
		G.selectedTargetId = firstAliveEnemy
		if G.combatantCards[G.selectedTargetId] then
			G.combatantCards[G.selectedTargetId].TurnStroke.Color = PALETTE.HeroRed
			G.combatantCards[G.selectedTargetId].TurnStroke.Transparency = 0
		end
	end

	-- Remove dead combatants
	for id, cardData in pairs(G.combatantCards) do
		if not combatState.Combatants[id] then cardData.Card:Destroy(); G.combatantCards[id] = nil end
	end

	-- Rebuild moves with key hints (GDD 2.3.5)
	clearContainer(G.movesScrollGui)
	for i, move in ipairs(combatState.AvailableMoves) do
		local keyHint = (i <= 5) and tostring(i) or nil
		local moveData = createMove(i, move.Name, move.Type, move.Desc, move.IsQuirk, keyHint)
		moveData.SetState(move.State)

		if not isMyTurn or move.State == "Erasure" then
			moveData.Button.Gui.Active = false; moveData.Button.Gui.BackgroundTransparency = 0.6
		else
			moveData.Button:OnClick(function()
				if G.selectedTargetId then
					CombatActionEvent:FireServer(move.Id, G.selectedTargetId)
					for _, child in ipairs(G.movesScrollGui:GetChildren()) do
						if child:IsA("TextButton") then child.Active = false; child.BackgroundTransparency = 0.6 end
					end
				end
			end)
		end
	end

	-- Typewriter combat log
	if combatState.LogMessage and combatState.LogMessage ~= "" and G.combatLogText then
		local ticket = os.clock()
		G.combatLogText.Gui:SetAttribute("AnimTicket", ticket)
		G.combatLogText:SetText(combatState.LogMessage)

		task.spawn(function()
			local len = utf8.len(G.combatLogText.Gui.ContentText) or string.len(G.combatLogText.Gui.ContentText)
			G.combatLogText.Gui.MaxVisibleGraphemes = 0
			for i = 1, len do
				if G.combatLogText.Gui:GetAttribute("AnimTicket") ~= ticket then break end
				G.combatLogText.Gui.MaxVisibleGraphemes = i
				task.wait(0.005)
			end
			G.combatLogText.Gui.MaxVisibleGraphemes = len
		end)
	end
end

