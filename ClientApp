	-- ═══════════════════════════════════════════
	-- MINIGAME 7: PACHINKO (Plus Ultra Pachinko)
	-- Ball bounces through pegs. Visual animation.
	-- ═══════════════════════════════════════════
	local function runPachinko(encounter)
		clearMinigameArea()
		mgTitle.Text = "🎰 PLUS ULTRA PACHINKO!"
		mgDesc.Text = "Choose launch position, then hit LAUNCH!"
		mgTimer.Text = "Ready!"; mgTimer.TextColor3 = PALETTE.BrightYellow
		minigameOverlay.Visible = true

		local slots = encounter.slots or {}
		local launched = false

		-- Launch position selector
		local launchFrame = Instance.new("Frame", mgArea)
		launchFrame.Size=UDim2.new(0.8,0,0,30); launchFrame.AnchorPoint=Vector2.new(0.5,0); launchFrame.Position=UDim2.new(0.5,0,0.02,0)
		launchFrame.BackgroundColor3=Color3.fromRGB(30,35,50); launchFrame.BorderSizePixel=0; launchFrame.ZIndex=32
		Instance.new("UICorner", launchFrame).CornerRadius=UDim.new(0,6)

		local positions = {"← Left", "Center", "Right →"}
		local selectedPos = 2
		local posLay = Instance.new("UIListLayout", launchFrame); posLay.FillDirection=Enum.FillDirection.Horizontal
		posLay.HorizontalAlignment=Enum.HorizontalAlignment.Center; posLay.Padding=UDim.new(0,4)

		local posButtons = {}
		for i, posName in ipairs(positions) do
			local pb = Instance.new("TextButton", launchFrame)
			pb.Size=UDim2.new(0.3,0,0.85,0); pb.BackgroundColor3=(i==2) and PALETTE.UA_BlueLight or PALETTE.PanelHighlight
			pb.BorderSizePixel=0; pb.Text=posName; pb.Font=Enum.Font.GothamBold; pb.TextSize=10
			pb.TextColor3=PALETTE.TextPrimary; pb.AutoButtonColor=false; pb.ZIndex=33
			Instance.new("UICorner", pb).CornerRadius=UDim.new(0,4)
			posButtons[i] = pb
			pb.MouseButton1Click:Connect(function()
				if launched then return end
				selectedPos = i
				for j, b in ipairs(posButtons) do b.BackgroundColor3 = (j==i) and PALETTE.UA_BlueLight or PALETTE.PanelHighlight end
			end)
		end

		-- Peg board visualization
		local pegBoard = Instance.new("Frame", mgArea)
		pegBoard.Size=UDim2.new(0.8,0,0.45,0); pegBoard.AnchorPoint=Vector2.new(0.5,0); pegBoard.Position=UDim2.new(0.5,0,0.15,0)
		pegBoard.BackgroundColor3=Color3.fromRGB(20,24,35); pegBoard.BorderSizePixel=0; pegBoard.ZIndex=32
		Instance.new("UICorner", pegBoard).CornerRadius=UDim.new(0,6)

		-- Draw pegs
		for row = 1, 5 do
			local pegsInRow = (row % 2 == 1) and 6 or 5
			for p = 1, pegsInRow do
				local peg = Instance.new("Frame", pegBoard)
				local xOff = (row % 2 == 0) and 0.08 or 0
				peg.Size=UDim2.new(0,8,0,8)
				peg.Position=UDim2.new(xOff + (p-1)/(pegsInRow), 0, (row-1)/5, 4)
				peg.BackgroundColor3=Color3.fromRGB(100,110,140); peg.BorderSizePixel=0; peg.ZIndex=33
				Instance.new("UICorner", peg).CornerRadius=UDim.new(1,0)
			end
		end

		-- Slot displays at bottom
		local slotFrame = Instance.new("Frame", mgArea)
		slotFrame.Size=UDim2.new(0.85,0,0,60); slotFrame.AnchorPoint=Vector2.new(0.5,1); slotFrame.Position=UDim2.new(0.5,0,0.95,0)
		slotFrame.BackgroundTransparency=1; slotFrame.ZIndex=32
		local slotLay = Instance.new("UIListLayout", slotFrame); slotLay.FillDirection=Enum.FillDirection.Horizontal
		slotLay.HorizontalAlignment=Enum.HorizontalAlignment.Center; slotLay.Padding=UDim.new(0,3)

		local slotFrames = {}
		for i, slot in ipairs(slots) do
			local sf = Instance.new("Frame", slotFrame)
			sf.Size=UDim2.new(1/#slots,-4,1,0); sf.BackgroundColor3=PALETTE.PanelHighlight; sf.BorderSizePixel=0; sf.ZIndex=33
			Instance.new("UICorner", sf).CornerRadius=UDim.new(0,4)
			local sl = Instance.new("TextLabel", sf); sl.Size=UDim2.new(1,-4,1,0); sl.Position=UDim2.new(0,2,0,0)
			sl.BackgroundTransparency=1; sl.Text=slot.label; sl.Font=Enum.Font.GothamBold
			sl.TextSize=8; sl.TextColor3=PALETTE.TextMuted; sl.TextWrapped=true; sl.ZIndex=34
			table.insert(slotFrames, sf)
		end

		-- Launch button
		local launchBtn = Instance.new("TextButton", mgArea)
		launchBtn.Size=UDim2.new(0,140,0,36); launchBtn.AnchorPoint=Vector2.new(0.5,0)
		launchBtn.Position=UDim2.new(0.5,0,0.62,0); launchBtn.BackgroundColor3=PALETTE.HeroRed
		launchBtn.Text="🔴 LAUNCH!"; launchBtn.TextColor3=Color3.fromRGB(255,255,255)
		launchBtn.Font=Enum.Font.GothamBlack; launchBtn.TextSize=14; launchBtn.BorderSizePixel=0; launchBtn.ZIndex=34; launchBtn.AutoButtonColor=false
		Instance.new("UICorner", launchBtn).CornerRadius=UDim.new(0,8); applyHoverEffect(launchBtn, 1.08, 20)

		launchBtn.MouseButton1Click:Connect(function()
			if launched then return end
			launched = true; launchBtn.Visible = false

			-- Position slightly influences odds (center = slightly better for middle slots)
			local posBonus = {-5, 0, 5} -- shifts the roll slightly
			local roll = math.clamp(math.random(1, 100) + (posBonus[selectedPos] or 0), 1, 100)
			local cumulative = 0; local winIndex = 1
			for i, slot in ipairs(slots) do
				cumulative += slot.chance
				if roll <= cumulative then winIndex = i; break end
			end

			-- Ball animation through peg board
			local ball = Instance.new("Frame", pegBoard)
			ball.Size=UDim2.new(0,12,0,12); ball.BackgroundColor3=PALETTE.BrightYellow; ball.BorderSizePixel=0; ball.ZIndex=35
			Instance.new("UICorner", ball).CornerRadius=UDim.new(1,0)
			local startX = selectedPos == 1 and 0.2 or selectedPos == 3 and 0.8 or 0.5
			ball.Position = UDim2.new(startX, -6, 0, -6)

			task.spawn(function()
				-- Bounce through pegs
				for step = 1, 12 do
					local targetX = startX + (math.random(-15, 15) / 100)
					-- Gradually move toward winning slot position
					local slotX = (winIndex - 0.5) / #slots
					targetX = targetX + (slotX - targetX) * (step / 12) * 0.6
					targetX = math.clamp(targetX, 0.05, 0.95)

					TweenService:Create(ball, TweenInfo.new(0.12), {
						Position = UDim2.new(targetX, -6, step/12, -6)
					}):Play()
					task.wait(0.14)
				end
				ball:Destroy()

				-- Highlight winning slot
				for j, sf in ipairs(slotFrames) do
					sf.BackgroundColor3 = (j == winIndex) and PALETTE.HealGreen or PALETTE.PanelHighlight
				end
				local winLabel = slots[winIndex].label
				mgTimer.Text = winLabel; mgTimer.TextColor3 = PALETTE.BrightYellow
				local isBig = winLabel:find("JACKPOT") or winLabel:find("MEGA")
				showToast("🎰 " .. winLabel .. (isBig and " 🎉🎉🎉" or ""), isBig and PALETTE.BrightYellow or PALETTE.TextPrimary)
				task.wait(2)
				PatrolEvent:FireServer("MinigameResult", {result = "success", slotIndex = winIndex})
			end)
		end)
	end

	-- ═══════════════════════════════════════════
	-- MINIGAME 8: LOOT REVEAL (Lucky Find)
	-- Animated treasure chest reveal with rarity glow.
	-- ═══════════════════════════════════════════
	local function runLootReveal(encounter)
		clearMinigameArea()
		mgTitle.Text = "✨ Lucky Find!"
		mgDesc.Text = "Your foot catches on something buried in the rubble..."
		mgTimer.Text = ""; minigameOverlay.Visible = true

		local loot = encounter.lootTable or {}
		local roll = math.random(1, 100); local cumulative = 0; local winIndex = 1
		for i, item in ipairs(loot) do
			cumulative += item.chance
			if roll <= cumulative then winIndex = i; break end
		end

		-- Treasure chest
		local chest = Instance.new("TextButton", mgArea)
		chest.Size=UDim2.new(0,130,0,130); chest.AnchorPoint=Vector2.new(0.5,0.5)
		chest.Position=UDim2.new(0.5,0,0.45,0); chest.BackgroundColor3=PALETTE.PanelHighlight
		chest.BorderSizePixel=0; chest.Text="📦"; chest.TextSize=60; chest.AutoButtonColor=false; chest.ZIndex=32
		Instance.new("UICorner", chest).CornerRadius=UDim.new(0,16)
		applyHoverEffect(chest, 1.1, 20)

		local hint = Instance.new("TextLabel", mgArea)
		hint.Size=UDim2.new(0.6,0,0,20); hint.AnchorPoint=Vector2.new(0.5,0); hint.Position=UDim2.new(0.5,0,0.75,0)
		hint.BackgroundTransparency=1; hint.Text="Click the chest to open!"; hint.Font=Enum.Font.GothamBold
		hint.TextSize=12; hint.TextColor3=PALETTE.BrightYellow; hint.ZIndex=33

		-- Rarity glow ring
		local glow = Instance.new("Frame", mgArea)
		glow.Size=UDim2.new(0,150,0,150); glow.AnchorPoint=Vector2.new(0.5,0.5); glow.Position=UDim2.new(0.5,0,0.45,0)
		glow.BackgroundTransparency=1; glow.ZIndex=31
		Instance.new("UICorner", glow).CornerRadius=UDim.new(1,0)
		local gs = Instance.new("UIStroke", glow); gs.Color=PALETTE.BrightYellow; gs.Thickness=3; gs.Transparency=1

		local opened = false
		chest.MouseButton1Click:Connect(function()
			if opened then return end
			opened = true; hint.Text = "Opening..."

			-- Shake
			task.spawn(function()
				for s = 1, 8 do
					chest.Rotation = math.random(-8, 8)
					task.wait(0.06)
				end
				chest.Rotation = 0

				-- Reveal
				local rarityColors = {
					Color3.fromRGB(180,180,180), -- Common
					PALETTE.UA_BlueLight,         -- Uncommon
					PALETTE.BrightYellow,         -- Rare
					PALETTE.VillainPurple,        -- Epic
					PALETTE.HeroRed,              -- Legendary
				}
				local rColor = rarityColors[math.min(winIndex, #rarityColors)]

				TweenService:Create(gs, TweenInfo.new(0.3), {Transparency=0, Color=rColor, Thickness=6}):Play()
				TweenService:Create(chest, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
					Size=UDim2.new(0,160,0,160),
					BackgroundColor3=rColor
				}):Play()

				chest.Text = "🎁"
				task.wait(0.5)
				chest.Text = loot[winIndex].label
				chest.TextSize = 14
				hint.Text = loot[winIndex].label
				hint.TextColor3 = rColor

				showToast("Found: " .. loot[winIndex].label .. "!", rColor)
				task.wait(2)
				PatrolEvent:FireServer("MinigameResult", {result = "success", lootIndex = winIndex})
			end)
		end)
	end


	-- ─── ENCOUNTER CARD DISPLAY ───
	local currentEncounter = nil

	local function showEncounterCard(encounter)
		currentEncounter = encounter
		encounterOverlay.Visible = true

		local typeColors = {Combat=PALETTE.HeroRed, Objective=PALETTE.BrightYellow, MiniRaid=PALETTE.VillainPurple, Bonus=PALETTE.HealGreen}
		local col = typeColors[encounter.encounterType] or PALETTE.UA_BlueLight
		cardAccent.BackgroundColor3 = col
		cardIcon.Text = encounter.icon or "?"
		cardTitle.Text = encounter.title or "Encounter"
		cardTitle.TextColor3 = col

		local stars = string.rep("★", encounter.difficulty or 1) .. string.rep("☆", math.max(0, 5 - (encounter.difficulty or 1)))
		cardDifficulty.Text = stars
		cardStamina.Text = "⚡" .. (encounter.staminaCost or 0) .. " Stamina"
		cardDesc.Text = encounter.desc or ""
		dialogueText.Text = encounter.dialogue or ""
		cardMinigameDesc.Text = encounter.minigameDesc or ""

		-- Slide in animation
		encounterCard.Position = UDim2.new(1.2, 0, 0.5, 0)
		TweenService:Create(encounterCard, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
	end

	local function hideEncounterCard()
		TweenService:Create(encounterCard, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(-0.5, 0, 0.5, 0)}):Play()
		task.wait(0.35); encounterOverlay.Visible = false
	end

	-- ─── BUTTON HANDLERS ───
	patrolBtn.MouseButton1Click:Connect(function()
		print("[PatrolClient] Patrol button clicked, firing RequestEncounter")
		PatrolEvent:FireServer("RequestEncounter")
		patrolBtn.Text = "Searching..."; patrolBtn.Active = false
		task.delay(2, function() patrolBtn.Text = "⚔  PATROL!"; patrolBtn.Active = true end)
	end)

	endPatrolBtn.MouseButton1Click:Connect(function()
		PatrolEvent:FireServer("EndPatrol")
	end)

	engageBtn.MouseButton1Click:Connect(function()
		if not currentEncounter then return end
		hideEncounterCard()

		if currentEncounter.encounterType == "Combat" or currentEncounter.encounterType == "MiniRaid" then
			PatrolEvent:FireServer("EngageEncounter")
		else
			PatrolEvent:FireServer("EngageEncounter")
		end
	end)

	skipBtn.MouseButton1Click:Connect(function()
		PatrolEvent:FireServer("SkipEncounter")
		hideEncounterCard()
		showToast("Encounter skipped.", PALETTE.TextMuted)
	end)

	continueBtn.MouseButton1Click:Connect(function()
		resultOverlay.Visible = false
		minigameOverlay.Visible = false
		clearMinigameArea()
		updateStamina()
	end)

	-- ─── SERVER EVENT LISTENER ───
	PatrolEvent.OnClientEvent:Connect(function(action, data)
		print("[PatrolClient] Received:", action)

		if action == "EncounterCard" then
			showEncounterCard(data)
			patrolState.onPatrol = true
			endPatrolBtn.Visible = true

		elseif action == "StartCombat" then
			-- Route to combat page with patrol enemy data
			G.returnTab = "PATROL"
			if data and data.zoneId then
				local patrolData = nil
				if data.patrolEnemyKey then
					patrolData = {
						patrolEnemyKey = data.patrolEnemyKey,
						encounterTitle = data.encounterTitle or "Patrol Encounter",
					}
				end
				StartCombatEvent:FireServer(data.zoneId, patrolData)
			end
			switchTab("COMBAT", true)

		elseif action == "StartMinigame" then
			local mg = data.minigameType
			if mg == "ReactionTest" then runReactionTest(data)
			elseif mg == "DialogueChoice" then runDialogueChoice(data)
			elseif mg == "Pachinko" then runPachinko(data)
			elseif mg == "LootReveal" then runLootReveal(data)
			elseif mg == "BuffSelect" then
				-- Pro Hero Cameo: just show the buff
				showResult("Pro Hero Cameo!", (data.selectedHero and data.selectedHero.name or "A Pro Hero") .. " offers training advice!", data.selectedHero and data.selectedHero.buff or "+Buff")
				PatrolEvent:FireServer("MinigameResult", {result = "success"})
			elseif mg == "SequenceOrder" then runSequenceOrder(data)
			elseif mg == "PriorityChoice" then runPriorityChoice(data)
			elseif mg == "SpeedSort" then runSpeedSort(data)
			elseif mg == "MazeNavigate" then runMazeNavigate(data)
			end

		elseif action == "MinigameComplete" then
			minigameOverlay.Visible = false
			clearMinigameArea()
			local rewardStr = ""
			if data.rewards then
				for k, v in pairs(data.rewards) do
					if k ~= "patrolScore" and k ~= "text" then
						rewardStr = rewardStr .. "+" .. v .. " " .. k .. "  "
					end
				end
			end
			patrolState.score = data.totalScore or patrolState.score
			scoreLabel.Text = "Score: " .. patrolState.score
			showResult("Encounter Complete!", data.resultText or "Done!", rewardStr)

		elseif action == "EncounterSkipped" then
			-- Nothing to do

		elseif action == "NoStamina" then
			showToast("Not enough stamina! Need " .. (data.needed or 5) .. ", have " .. (data.stamina or 0), PALETTE.HeroRed)

		elseif action == "PatrolComplete" then
			patrolState.onPatrol = false
			endPatrolBtn.Visible = false
			local rewardStr = ""
			if data.bonusRewards then
				for k, v in pairs(data.bonusRewards) do
					rewardStr = rewardStr .. "+" .. v .. " " .. k .. "  "
				end
			end
			showResult(
				"Patrol Complete! " .. (data.rank or "D-Rank"),
				"Total Score: " .. (data.totalScore or 0) .. " | Encounters: " .. (data.encounterCount or 0),
				"Rank Bonus: " .. rewardStr
			)
			patrolState.score = 0
			scoreLabel.Text = "Score: 0"
			updateStamina()
		end
	end)
end


