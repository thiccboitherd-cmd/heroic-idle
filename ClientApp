local function createCombatant(name: string, isEnemy: boolean, maxHp: number, portraitId: string, isBoss: boolean?)
	local container = isEnemy and G.enemiesContainer or G.alliesContainer
	local h = isBoss and 100 or 78

	local card = UIFramework.UIFrame.new("Card_"..name, PALETTE.PanelHighlight, container)
	card.Gui.Size = UDim2.new(1, 0, 0, h)

	if isBoss then
		local bStroke = Instance.new("UIStroke", card.Gui)
		bStroke.Color = PALETTE.HeroRed; bStroke.Thickness = 2; bStroke.Transparency = 0.3
		-- Boss badge
		local badge = Instance.new("Frame", card.Gui)
		badge.Size = UDim2.new(0, 40, 0, 16)
		badge.AnchorPoint = Vector2.new(1, 0)
		badge.Position = UDim2.new(1, -5, 0, 5)
		badge.BackgroundColor3 = PALETTE.HeroRed; badge.BorderSizePixel = 0
		Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 4)
		local bl = Instance.new("TextLabel", badge)
		bl.Size = UDim2.new(1, 0, 1, 0); bl.BackgroundTransparency = 1
		bl.Text = "BOSS"; bl.TextColor3 = Color3.fromRGB(255, 255, 255)
		bl.Font = Enum.Font.GothamBlack; bl.TextSize = 9
	end

	local uiScale = Instance.new("UIScale", card.Gui)

	local pSize = isBoss and 72 or 56
	local portraitFrame = Instance.new("Frame", card.Gui)
	portraitFrame.Size = UDim2.new(0, pSize, 0, pSize)
	portraitFrame.Position = UDim2.new(0, 8, 0, (h - pSize)/2)
	portraitFrame.BackgroundColor3 = PALETTE.PanelCard; portraitFrame.BorderSizePixel = 0
	Instance.new("UICorner", portraitFrame).CornerRadius = UDim.new(1, 0)

	local portrait = Instance.new("ImageLabel", portraitFrame)
	portrait.Size = UDim2.new(1, -4, 1, -4); portrait.Position = UDim2.new(0, 2, 0, 2)
	portrait.Image = portraitId; portrait.BackgroundTransparency = 1
	Instance.new("UICorner", portrait).CornerRadius = UDim.new(1, 0)

	-- GDD 2.3.2: Breathing idle animation (scale pulse)
	task.spawn(function()
		local breathScale = Instance.new("UIScale", portraitFrame)
		while portraitFrame.Parent do
			TweenService:Create(breathScale, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Scale = 1.03}):Play()
			task.wait(5)
		end
	end)

	local statusRing = Instance.new("UIStroke", portraitFrame)
	statusRing.Thickness = 3; statusRing.Transparency = 1

	local infoX = pSize + 14
	local nameLabel = UIFramework.UILabel.new("Name", card.Gui)
	nameLabel.Gui.Size = UDim2.new(1, -(infoX + 10), 0, 22)
	nameLabel.Gui.Position = UDim2.new(0, infoX, 0, 8)
	nameLabel:SetText(name)
	nameLabel.Gui.Font = Enum.Font.GothamBold
	nameLabel.Gui.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Gui.TextSize = isBoss and 14 or 12

	-- HP Bar
	local hpBar = UIFramework.UIProgressBar.new("HPBar", card.Gui)
	hpBar.Gui.Size = UDim2.new(1, -(infoX + 10), 0, 12)
	hpBar.Gui.Position = UDim2.new(0, infoX, 0, 36)
	hpBar:SetProgress(1)
	local hpFill = hpBar.Gui:FindFirstChildWhichIsA("Frame")
	if hpFill then hpFill.BackgroundColor3 = isEnemy and PALETTE.HeroRed or PALETTE.HealGreen end

	local hpText = UIFramework.UILabel.new("HPText", hpBar.Gui)
	hpText.Gui.Size = UDim2.new(1, 0, 1, 0); hpText.Gui.ZIndex = 2
	hpText:SetText(maxHp .. "/" .. maxHp)
	hpText.Gui.TextSize = 9; hpText.Gui.Font = Enum.Font.GothamBold
	hpText.Gui.TextColor3 = Color3.fromRGB(255, 255, 255)

	-- Boss phase indicator (GDD 6.3.2)
	local phaseLabel = nil
	if isBoss then
		phaseLabel = Instance.new("TextLabel", card.Gui)
		phaseLabel.Size = UDim2.new(1, -(infoX + 10), 0, 14)
		phaseLabel.Position = UDim2.new(0, infoX, 0, 76)
		phaseLabel.BackgroundTransparency = 1
		phaseLabel.Text = "Phase 1"
		phaseLabel.TextColor3 = PALETTE.TextMuted
		phaseLabel.Font = Enum.Font.GothamBold; phaseLabel.TextSize = 10
		phaseLabel.TextXAlignment = Enum.TextXAlignment.Left
	end

	-- Status badges
	local statusBadge = Instance.new("TextLabel", card.Gui)
	statusBadge.Size = UDim2.new(1, -(infoX + 10), 0, 14)
	statusBadge.Position = UDim2.new(0, infoX, 0, 54)
	statusBadge.BackgroundTransparency = 1
	statusBadge.Text = ""; statusBadge.Font = Enum.Font.GothamBold; statusBadge.TextSize = 10
	statusBadge.TextXAlignment = Enum.TextXAlignment.Left

	local turnStroke = Instance.new("UIStroke", card.Gui)
	turnStroke.Color = PALETTE.TextPrimary; turnStroke.Thickness = 2; turnStroke.Transparency = 1

	local statusIcons = {
		Burn={icon="🔥",color=Color3.fromRGB(255,100,0)}, Bleed={icon="🩸",color=Color3.fromRGB(200,0,0)},
		Stun={icon="⚡",color=PALETTE.StatAGI}, Erasure={icon="🚫",color=Color3.fromRGB(150,150,150)},
		Gravity={icon="⬇",color=PALETTE.VillainPurple}, Brittle={icon="💢",color=Color3.fromRGB(180,120,50)},
		Corrode={icon="🧪",color=Color3.fromRGB(127,255,0)},
	}

	local function applyStatus(statusType: string)
		local info = statusIcons[statusType]
		if info then
			statusRing.Transparency = 0; statusRing.Color = info.color
			nameLabel.Gui.TextColor3 = info.color
			statusBadge.Text = info.icon .. " " .. statusType:upper()
			statusBadge.TextColor3 = info.color
		else
			statusRing.Transparency = 1
			nameLabel.Gui.TextColor3 = PALETTE.TextPrimary
			statusBadge.Text = ""
		end
	end

	local function triggerDamage()
		portraitFrame.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
		TweenService:Create(portraitFrame, TweenInfo.new(0.45), {BackgroundColor3 = PALETTE.PanelCard}):Play()
		TweenService:Create(card.Gui, TweenInfo.new(0.05), {Rotation = 3}):Play()
		TweenService:Create(uiScale, TweenInfo.new(0.05), {Scale = 0.94}):Play()
		task.wait(0.05)
		TweenService:Create(card.Gui, TweenInfo.new(0.05), {Rotation = -3}):Play()
		task.wait(0.05)
		TweenService:Create(card.Gui, TweenInfo.new(0.08), {Rotation = 0}):Play()
		TweenService:Create(uiScale, TweenInfo.new(0.12), {Scale = 1}):Play()
	end

	local function updatePhase(hpPercent: number)
		if phaseLabel then
			if hpPercent <= 0.2 then
				phaseLabel.Text = "⚠ PHASE 3 — DESPERATION (+25% DMG)"
				phaseLabel.TextColor3 = PALETTE.HeroRed
			elseif hpPercent <= 0.5 then
				phaseLabel.Text = "⚠ PHASE 2 — ENRAGED"
				phaseLabel.TextColor3 = PALETTE.BrightYellow
			else
				phaseLabel.Text = "Phase 1"
				phaseLabel.TextColor3 = PALETTE.TextMuted
			end
		end
	end

	return {
		Card = card.Gui, ApplyStatus = applyStatus, HPBar = hpBar, HPText = hpText,
		TriggerDamage = triggerDamage, TurnStroke = turnStroke, Portrait = portraitFrame,
		UpdatePhase = updatePhase, CurrentHP = maxHp
	}
end

