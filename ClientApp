--[[
	GDD 2.3.6 Damage Text Types:
	  Normal:  White, 28pt, fade 1.2s
	  Crit:    Yellow w/ black stroke, 42pt, scale bounce, fade 1.5s
	  Heal:    Green, 28pt, "+X" prefix
	  Status:  Purple, 24pt, "BURNED!" text, shake anim
	  Block:   Gray, 20pt, "BLOCKED"/"RESIST", fade 0.8s
]]
local function spawnFloatingText(text: string, textType: string, screenPos: UDim2)
	if not G.floatingTextLayer then return end

	local label = Instance.new("TextLabel", G.floatingTextLayer)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = screenPos
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextStrokeTransparency = 0.5
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.ZIndex = 151

	local fadeDur = 1.2

	if textType == "Crit" then
		label.TextColor3 = PALETTE.BrightYellow
		label.Font = Enum.Font.GothamBlack
		label.TextSize = 32
		label.Size = UDim2.new(0, 200, 0, 50)
		fadeDur = 1.5
		-- Scale bounce
		local scale = Instance.new("UIScale", label)
		scale.Scale = 0.5
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Scale = 1.3}):Play()
		task.delay(0.12, function()
			TweenService:Create(scale, TweenInfo.new(0.1), {Scale = 1.0}):Play()
		end)
	elseif textType == "Heal" then
		label.TextColor3 = PALETTE.HealGreen
		label.Font = Enum.Font.GothamBold
		label.TextSize = 20
		label.Size = UDim2.new(0, 140, 0, 30)
	elseif textType == "Status" then
		label.TextColor3 = PALETTE.VillainPurple
		label.Font = Enum.Font.GothamBlack
		label.TextSize = 18
		label.Size = UDim2.new(0, 160, 0, 30)
