-- ==========================================
-- UIButton: A clickable text button with styling
-- ==========================================
local UIButton = {}
UIButton.__index = UIButton

function UIButton.new(name, text, bgColor, parent)
	local self = setmetatable({}, UIButton)

	local button = Instance.new("TextButton")
	button.Name = name or "UIButton"
	button.Text = text or ""
	button.BackgroundColor3 = bgColor or Color3.fromRGB(30, 38, 60)
	button.BorderSizePixel = 0
	button.TextColor3 = Color3.fromRGB(200, 205, 220)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 14
	button.AutoButtonColor = false
	button.Size = UDim2.new(1, 0, 0, 36)

	local corner = Instance.new("UICorner", button)
	corner.CornerRadius = UDim.new(0, 8)

	if parent then
		if typeof(parent) == "Instance" then
			button.Parent = parent
		elseif typeof(parent) == "table" and parent.Gui then
			button.Parent = parent.Gui
		end
	end

	self.Gui = button
	self._connections = {}
	return self
end

function UIButton:SetText(text)
	self.Gui.Text = text or ""
end

function UIButton:OnClick(callback)
	local conn = self.Gui.MouseButton1Click:Connect(callback)
	table.insert(self._connections, conn)
	return conn
end

UIFramework.UIButton = UIButton

