-- UIFramework.lua — Place in ReplicatedStorage as a ModuleScript named "UIFramework"
-- Lightweight UI component factory used by the client script

local TweenService = game:GetService("TweenService")
local UIFramework = {}

-- ==========================================
-- UIFrame: A styled panel with corner radius + stroke
-- ==========================================
local UIFrame = {}
UIFrame.__index = UIFrame

function UIFrame.new(name, bgColor, parent)
	local self = setmetatable({}, UIFrame)

	local frame = Instance.new("Frame")
	frame.Name = name or "UIFrame"
	frame.BackgroundColor3 = bgColor or Color3.fromRGB(22, 28, 46)
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, 0, 1, 0)

	local corner = Instance.new("UICorner", frame)
	corner.CornerRadius = UDim.new(0, 8)

	if parent then
		frame.Parent = parent
		if typeof(parent) == "Instance" and parent:IsA("GuiObject") then
			-- auto parent
		elseif typeof(parent) == "table" and parent.Gui then
			frame.Parent = parent.Gui
		end
	end

	self.Gui = frame
	return self
end

UIFramework.UIFrame = UIFrame

