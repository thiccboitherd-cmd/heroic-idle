-- ==========================================
-- UIProgressBar: A horizontal fill bar
-- ==========================================
local UIProgressBar = {}
UIProgressBar.__index = UIProgressBar

function UIProgressBar.new(name, parent)
	local self = setmetatable({}, UIProgressBar)

	local bg = Instance.new("Frame")
	bg.Name = name or "UIProgressBar"
	bg.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	bg.BorderSizePixel = 0
	bg.Size = UDim2.new(1, 0, 0, 10)

	local bgCorner = Instance.new("UICorner", bg)
	bgCorner.CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame", bg)
	fill.Name = "Fill"
	fill.BackgroundColor3 = Color3.fromRGB(115, 195, 235)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(0, 0, 1, 0)

	local fillCorner = Instance.new("UICorner", fill)
	fillCorner.CornerRadius = UDim.new(1, 0)

	if parent then
		if typeof(parent) == "Instance" then
			bg.Parent = parent
		elseif typeof(parent) == "table" and parent.Gui then
			bg.Parent = parent.Gui
		end
	end

	self.Gui = bg
	self.Fill = fill
	self._progress = 0
	return self
end

function UIProgressBar:SetProgress(pct)
	pct = math.clamp(pct or 0, 0, 1)
	self._progress = pct
	TweenService:Create(self.Fill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(pct, 0, 1, 0)
	}):Play()
end

function UIProgressBar:GetProgress()
	return self._progress
end

UIFramework.UIProgressBar = UIProgressBar

return UIFramework
