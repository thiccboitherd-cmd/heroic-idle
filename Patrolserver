-- ==========================================
-- PLAYER PATROL STATE
-- ==========================================
local PatrolSessions = {} -- [player] = {score, encounterCount, stamina, currentEncounter, ...}

local function getOrCreateSession(player)
	if not PatrolSessions[player] then
		PatrolSessions[player] = {
			score = 0, encounterCount = 0, active = false,
			currentEncounter = nil, pachinkoUsed = false,
		}
	end
	return PatrolSessions[player]
end

Players.PlayerRemoving:Connect(function(p) PatrolSessions[p] = nil end)

-- ==========================================
-- ENCOUNTER GENERATOR
-- ==========================================
local function rollEncounterType()
	local roll = math.random(1, 100)
	if roll <= 45 then return "Combat"
	elseif roll <= 70 then return "Objective"
	elseif roll <= 80 then return "MiniRaid"
	else return "Bonus" end
end

local function generateEncounter(player, session)
	local encounterType = rollEncounterType()

	-- Deep-copy a table (1 level deep is enough for our data)
	local function copyTable(t)
		local copy = {}
		for k, v in pairs(t) do
			if type(v) == "table" then
				copy[k] = {}
				for k2, v2 in pairs(v) do
					if type(v2) == "table" then
						copy[k][k2] = {}
						for k3, v3 in pairs(v2) do copy[k][k2][k3] = v3 end
					else
						copy[k][k2] = v2
					end
				end
			else
				copy[k] = v
			end
		end
		return copy
	end

	if encounterType == "Combat" then
		local source = CombatEncounters[math.random(1, #CombatEncounters)]
		local encounter = copyTable(source)
		encounter.encounterType = "Combat"
		return encounter

	elseif encounterType == "Objective" then
		local source = ObjectiveEncounters[math.random(1, #ObjectiveEncounters)]
		local encounter = copyTable(source)
		encounter.encounterType = "Objective"
		return encounter

	elseif encounterType == "MiniRaid" then
		return {
			encounterType = "MiniRaid",
			title = "Emergency Alert: Mini-Raid!",
			difficulty = 3, icon = "💀",
			desc = "Multiple hostiles detected! A coordinated villain attack requires immediate response. Prepare for multi-wave combat!",
			dialogue = "DISPATCH: \"All available heroes — converge on sector 7! This is not a drill!\"",
			staminaCost = 15, patrolScore = 25,
			waves = 3,
			rewards = {HeroCoins = 150, TrainingXP = 100, Spins = 1},
		}

	elseif encounterType == "Bonus" then
		local bonusRoll = math.random(1, #BonusEncounters)
		if BonusEncounters[bonusRoll].category == "Pachinko" and session.pachinkoUsed then
			bonusRoll = 2
		end
		local encounter = copyTable(BonusEncounters[bonusRoll])
		encounter.encounterType = "Bonus"

		if encounter.category == "Fan" then
			encounter.dialogue = "FAN: \"Oh my gosh, you're " .. player.Name .. "! Can I get an autograph?!\""
		end

		if encounter.category == "ProHero" and encounter.heroes then
			local hero = encounter.heroes[math.random(1, #encounter.heroes)]
			encounter.selectedHero = {name = hero.name, buff = hero.buff, reward = hero.reward}
			encounter.dialogue = hero.name .. ": \"Hey kid. Not bad patrol work. Here's a tip...\""
			encounter.desc = hero.name .. " appears! They offer: " .. hero.buff
			encounter.heroes = nil -- remove the full list, only send selected
		end

		-- Randomize Lucky Find rewards at generation time
		if encounter.category == "LuckyFind" and encounter.lootTable then
			for _, loot in ipairs(encounter.lootTable) do
				if loot.reward and loot.reward.HeroCoins then
					loot.reward.HeroCoins = math.random(10, 50) -- re-roll
				end
				if loot.reward and loot.reward.TrainingXP then
					loot.reward.TrainingXP = math.random(25, 75)
				end
			end
		end

		return encounter
	end

	return nil
end

-- ==========================================
-- REWARD APPLICATION
-- ==========================================
local function applyRewards(player, rewards)
	local stats = player:FindFirstChild("PlayerStats")
	if not stats then return end

	for rewardName, amount in pairs(rewards) do
		if rewardName == "patrolScore" or rewardName == "text" then continue end
		local val = stats:FindFirstChild(rewardName)
		if val and val:IsA("IntValue") then
			val.Value = val.Value + amount
		end
	end
end

local function getPatrolRank(score)
	if score >= 500 then return "SS-Rank", {HeroCoins=1500, TrainingXP=800, Spins=8}
	elseif score >= 350 then return "S-Rank", {HeroCoins=1000, TrainingXP=500, Spins=5}
	elseif score >= 200 then return "A-Rank", {HeroCoins=600, TrainingXP=300, Spins=3}
	elseif score >= 100 then return "B-Rank", {HeroCoins=300, TrainingXP=150, Spins=1}
	elseif score >= 50 then return "C-Rank", {HeroCoins=150, TrainingXP=50}
	else return "D-Rank", {HeroCoins=50} end
end

-- ==========================================
-- PATROL EVENT HANDLER
-- ==========================================
PatrolEvent.OnServerEvent:Connect(function(player, action, data)
	local stats = player:FindFirstChild("PlayerStats")
	if not stats then print("[PatrolServer] No PlayerStats for", player.Name); return end
	local session = getOrCreateSession(player)

	print("[PatrolServer] Action:", action, "from", player.Name)

	if action == "RequestEncounter" then
		local stamina = stats:FindFirstChild("PatrolStamina")
		if not stamina then
			-- Auto-create if missing (Studio reload / race condition)
			stamina = Instance.new("IntValue", stats)
			stamina.Name = "PatrolStamina"
			stamina.Value = 100
			print("[PatrolServer] Created missing PatrolStamina for", player.Name)
		end

		local scoreVal = stats:FindFirstChild("PatrolScore")
		if not scoreVal then
			scoreVal = Instance.new("IntValue", stats)
			scoreVal.Name = "PatrolScore"
			scoreVal.Value = 0
		end

		local encounter = generateEncounter(player, session)
		if not encounter then print("[PatrolServer] Failed to generate encounter!"); return end

		print("[PatrolServer] Generated:", encounter.encounterType, encounter.title, "Cost:", encounter.staminaCost)

		if stamina.Value < (encounter.staminaCost or 5) then
			PatrolEvent:FireClient(player, "NoStamina", {
				stamina = stamina.Value,
				needed = encounter.staminaCost or 5,
			})
			return
		end

		stamina.Value = stamina.Value - (encounter.staminaCost or 5)
		session.currentEncounter = encounter
		session.encounterCount = session.encounterCount + 1
		session.active = true

		-- Send encounter card to client
		print("[PatrolServer] Sending EncounterCard to", player.Name)
		PatrolEvent:FireClient(player, "EncounterCard", encounter)

	elseif action == "EngageEncounter" then
		local encounter = session.currentEncounter
		if not encounter then print("[PatrolServer] No current encounter!"); return end

		if encounter.encounterType == "Combat" or encounter.encounterType == "MiniRaid" then
			local hz = stats:FindFirstChild("HighestZoneCleared")
			local zoneId = tostring(math.max(1, (hz and hz.Value or 0) + 1))

			session.score = session.score + (encounter.patrolScore or 10)
			applyRewards(player, encounter.rewards or {})

			local scoreVal = stats:FindFirstChild("PatrolScore")
			if scoreVal then scoreVal.Value = session.score end

			-- Use the patrolEnemyKey from the encounter directly
			local patrolEnemyKey = encounter.patrolEnemyKey or "Purse_Snatcher"

			-- Mini-Raid: start with wave 1
			if encounter.encounterType == "MiniRaid" then
				patrolEnemyKey = "MiniRaid_Wave1"
				session.miniRaidWave = 1
			end

			-- 5% RARE BOSS SPAWN (overrides normal encounter)
			if encounter.encounterType == "Combat" and math.random(1, 100) <= 5 then
				patrolEnemyKey = "Patrol_Boss"
				session.score = session.score + 20 -- bonus score for boss
				if scoreVal then scoreVal.Value = session.score end
				print("[PatrolServer] RARE BOSS SPAWN for", player.Name)
			end

			-- Tell the CLIENT to fire StartCombatEvent with patrol data
			PatrolEvent:FireClient(player, "StartCombat", {
				zoneId = zoneId,
				patrolEnemyKey = patrolEnemyKey,
				encounterTitle = encounter.title,
			})

		elseif encounter.encounterType == "Objective" or encounter.encounterType == "Bonus" then
			PatrolEvent:FireClient(player, "StartMinigame", encounter)
		end

	elseif action == "MinigameResult" then
		-- data = {result = "perfect"|"success"|"failure", score = number}
		local encounter = session.currentEncounter
		if not encounter then return end

		local result = data and data.result or "failure"
		local rewards = {}

		if encounter.rewards and encounter.rewards[result] then
			rewards = encounter.rewards[result]
		elseif encounter.minigameType == "DialogueChoice" and data and data.choiceIndex then
			local choice = encounter.choices and encounter.choices[data.choiceIndex]
			if choice then rewards = choice.reward or {} end
		elseif encounter.minigameType == "Pachinko" and data and data.slotIndex then
			local slot = encounter.slots and encounter.slots[data.slotIndex]
			if slot then rewards = slot.reward or {}; session.pachinkoUsed = true end
		elseif encounter.minigameType == "LootReveal" and data and data.lootIndex then
			local loot = encounter.lootTable and encounter.lootTable[data.lootIndex]
			if loot then rewards = loot.reward or {} end
		elseif encounter.minigameType == "BuffSelect" and encounter.selectedHero then
			rewards = encounter.selectedHero.reward or {}
		end

		-- Apply rewards
		applyRewards(player, rewards)
		session.score = session.score + (rewards.patrolScore or 0)

		local scoreVal = stats:FindFirstChild("PatrolScore")
		if scoreVal then scoreVal.Value = session.score end

		-- Send result back to client
		PatrolEvent:FireClient(player, "MinigameComplete", {
			rewards = rewards,
			resultText = rewards.text or (result == "perfect" and "Perfect!" or result == "success" and "Success!" or "Better luck next time."),
			totalScore = session.score,
		})

		session.currentEncounter = nil

	elseif action == "SkipEncounter" then
		session.currentEncounter = nil
		PatrolEvent:FireClient(player, "EncounterSkipped", {})

	elseif action == "EndPatrol" then
		-- Calculate final rank (GDD 8.3)
		local rank, bonusRewards = getPatrolRank(session.score)
		applyRewards(player, bonusRewards)

		PatrolEvent:FireClient(player, "PatrolComplete", {
			rank = rank,
			totalScore = session.score,
			encounterCount = session.encounterCount,
			bonusRewards = bonusRewards,
		})

		-- Reset session
		PatrolSessions[player] = nil

		-- Reset patrol score
		local scoreVal = stats:FindFirstChild("PatrolScore")
		if scoreVal then scoreVal.Value = 0 end
	end
end)

print("[PatrolServer] Loaded — Full GDD 8.x patrol system active.")
