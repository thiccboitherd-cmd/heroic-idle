-- ==========================================
-- ROLL LOGIC
-- ==========================================
local function performRoll(player, category)
	local stats = player:FindFirstChild("PlayerStats")
	if not stats then return end

	local targetValue = stats:FindFirstChild("Current" .. category)
	if not targetValue then return end

	local rarity = rollRarity()
	local available = GachaPools[category][rarity]
	if not available or #available == 0 then
		available = GachaPools[category]["Common"]
	end

	local result = available[math.random(1, #available)]
	targetValue.Value = result

	-- Clear move slots when quirk or style changes (prevent stale moves)
	if category == "Quirk" or category == "Style" then
		for i = 1, 4 do
			local slot = stats:FindFirstChild("MoveSlot" .. i)
			if slot then slot.Value = "" end
		end
		-- Auto-equip basic_strike so player isn't left with no moves
		local slot1 = stats:FindFirstChild("MoveSlot1")
		if slot1 then slot1.Value = "basic_strike" end
	end

	-- Grant mastery XP
	local masteryVal = stats:FindFirstChild(category .. "MasteryXP")
	if masteryVal then
		masteryVal.Value = masteryVal.Value + 10
	end

	print("[GachaServer] " .. player.Name .. " rolled " .. rarity .. " " .. category .. ": " .. result)
end

-- ==========================================
-- AUTO-ROLL ON FIRST JOIN (if None)
-- ==========================================
Players.PlayerAdded:Connect(function(player)
	local stats = player:WaitForChild("PlayerStats", 10)
	if not stats then return end

	task.wait(2) -- wait for data to load

	if stats:FindFirstChild("CurrentQuirk") and stats.CurrentQuirk.Value == "None" then
		performRoll(player, "Quirk")
	end
	if stats:FindFirstChild("CurrentTrait") and stats.CurrentTrait.Value == "None" then
		performRoll(player, "Trait")
	end
	if stats:FindFirstChild("CurrentStyle") and stats.CurrentStyle.Value == "None" then
		performRoll(player, "Style")
	end
end)

-- Handle players already in server (Studio testing)
for _, player in ipairs(Players:GetPlayers()) do
	local stats = player:FindFirstChild("PlayerStats")
	if stats then
		task.defer(function()
			task.wait(1)
			if stats:FindFirstChild("CurrentQuirk") and stats.CurrentQuirk.Value == "None" then performRoll(player, "Quirk") end
			if stats:FindFirstChild("CurrentTrait") and stats.CurrentTrait.Value == "None" then performRoll(player, "Trait") end
			if stats:FindFirstChild("CurrentStyle") and stats.CurrentStyle.Value == "None" then performRoll(player, "Style") end
		end)
	end
end

-- ==========================================
-- GACHA ROLL EVENT (costs 1 Spin)
-- ==========================================
RollGachaEvent.OnServerEvent:Connect(function(player, category)
	if category ~= "Quirk" and category ~= "Trait" and category ~= "Style" then return end

	local stats = player:FindFirstChild("PlayerStats")
	if not stats then return end

	local spins = stats:FindFirstChild("Spins")
	if not spins or spins.Value < 1 then return end

	spins.Value = spins.Value - 1
	performRoll(player, category)
end)

-- ==========================================
-- STAT UPGRADE EVENT (costs level * 10 Training XP)
-- ==========================================
UpgradeStatEvent.OnServerEvent:Connect(function(player, statName)
	local stats = player:FindFirstChild("PlayerStats")
	if not stats then return end

	-- Validate stat name
	local validStats = {Strength=true, Agility=true, Endurance=true, Intelligence=true, QuirkFactor=true}
	if not validStats[statName] then return end

	local stat = stats:FindFirstChild(statName)
	local xp = stats:FindFirstChild("TrainingXP")
	if not stat or not xp then return end

	local cost = stat.Value * 10
	if xp.Value >= cost then
		xp.Value = xp.Value - cost
		stat.Value = stat.Value + 1
	end
end)

print("[GachaServer] Loaded — Gacha rolls, stat upgrades, and auto-roll active.")
