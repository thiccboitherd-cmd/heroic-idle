-- ServerScriptService/GachaServer.lua
-- Handles gacha rolling, stat upgrades, and auto-roll on first join
-- NOTE: This script owns UpgradeStatEvent and RollGachaEvent.
--       Do NOT add duplicate handlers in ServerSetup.lua or other scripts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UpgradeStatEvent = ReplicatedStorage:WaitForChild("UpgradeStatEvent")
local RollGachaEvent = ReplicatedStorage:WaitForChild("RollGachaEvent")

-- ==========================================
-- RNG WEIGHT SYSTEM (100,000 scale for precision)
-- ==========================================
local function rollRarity()
	local rng = math.random(1, 100000)
	if rng > 60000 then return "Trash"         -- 40%
	elseif rng > 30000 then return "Common"    -- 30%
	elseif rng > 15000 then return "Uncommon"  -- 15%
	elseif rng > 7000 then return "Rare"       -- 8%
	elseif rng > 3000 then return "Elite"      -- 4%
	elseif rng > 1000 then return "Epic"       -- 2%
	elseif rng > 200 then return "Legendary"   -- 0.8%
	elseif rng > 50 then return "Mythic"       -- 0.15%
	else return "Secret" end                   -- 0.05%
end

