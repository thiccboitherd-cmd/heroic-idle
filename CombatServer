local function RollLoot(tier)
	local lootPool = LootTables[tier] or LootTables[1]
	local roll = math.random(1, 100)
	local cumulative = 0
	for _, entry in ipairs(lootPool) do
		cumulative = cumulative + entry.chance
		if roll <= cumulative then return entry.item end
	end
	return nil
end

