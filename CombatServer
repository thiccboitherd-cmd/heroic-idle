		Phase2Script="highend_flight", Phase3Script="highend_desperation",
		PassiveRegen=0.08,
	},
}

-- ==========================================
-- BATTLE STATE
-- ==========================================
local BattleState = {
	IsActive = false, TurnQueue = {}, ActiveTurn = "",
	Combatants = {}, Result = nil, CurrentLog = "",
	IsGauntlet = false, ZoneId = "1", Wave = 1,
	ExamPoints = 0, AccumulatedRewards = {},
	StartTime = 0, ZeroPointerSpawned = false,
	AwakeningMeter = 0, -- GDD 5.4: 0-100%
	TurnCount = 0,
}

-- ==========================================
-- LOGGING & UTILITY
-- ==========================================
local StatusColors = {
	Burn="#FF5500", Bleed="#CC0000", Stun="#FFFF00", Corrode="#32CD32",
	Hardened="#A9A9A9", Brittle="#87CEFA", Erasure="#800080", Float="#DDA0DD",
	Overclock="#FF8C00", Haste="#00FF88", Shield="#AAAAFF", Blind="#888888",
	Weaken="#AA6600", DodgeUp="#00DDAA", HighDodge="#00FFCC",
	ArmorUp="#8888FF", CounterStance="#FF00FF", FocusAim="#FF4400",
}

local function Colorize(text, status)
	return string.format("<font color='%s'><b>%s</b></font>", StatusColors[status] or "#FFFFFF", text)
end

local function AppendLog(msg)
	if BattleState.CurrentLog == "" then
		BattleState.CurrentLog = msg
	else
		BattleState.CurrentLog = BattleState.CurrentLog .. " " .. msg
	end
end

-- ==========================================
-- GDD 5.4: AWAKENING METER
-- ==========================================
local function AddAwakening(amount)
	BattleState.AwakeningMeter = math.clamp(BattleState.AwakeningMeter + amount, 0, 1)
end

-- ==========================================
-- HEALING (referenced by moves)
-- ==========================================
local function HealEntity(entity, amount)
	if not entity or entity.HP <= 0 then return end
	local healed = math.min(amount, entity.MaxHP - entity.HP)
	entity.HP = math.clamp(entity.HP + healed, 0, entity.MaxHP)
	if healed > 0 then
		AppendLog(Colorize(entity.Name .. " healed " .. math.floor(healed) .. " HP!", "Shield"))
	end
end

-- ==========================================
-- STATUS EFFECT APPLICATION
-- ==========================================
local function ApplyStatus(target, statusType, duration)
	if not target then return end

	-- Corrode stacks permanently (GDD 5.3)
	if statusType == "Corrode" then
		target.CorrodeStacks = (target.CorrodeStacks or 0) + 1
		AppendLog(Colorize(target.Name .. " corroded! (Stack " .. target.CorrodeStacks .. ", -" .. (target.CorrodeStacks * 8) .. "% DEF)", "Corrode"))
		AddAwakening(0.03) -- applying status = 3%
		return
	end

	-- Shield replaces (strongest wins)
	if statusType == "Shield" then
		target.ShieldHP = duration -- reuse duration as shield HP amount
		target.Status = { Type = "Shield", Duration = 3 }
		AppendLog(Colorize(target.Name .. " gained a " .. duration .. " HP Shield!", "Shield"))
		AddAwakening(0.03)
		return
	end

	-- Stun immunity for 1 turn after being stunned (GDD 5.3)
	if statusType == "Stun" and target.StunImmuneTurns and target.StunImmuneTurns > 0 then
		AppendLog(target.Name .. " resisted the stun!")
		return
	end

	-- Bleed stacks up to 3x (GDD 5.3)
	if statusType == "Bleed" then
		target.BleedStacks = math.min((target.BleedStacks or 0) + 1, 3)
		target.Status = { Type = "Bleed", Duration = math.max(duration, target.Status and target.Status.Duration or 0) }
		AppendLog("Inflicted " .. Colorize("Bleed x" .. target.BleedStacks, "Bleed") .. "!")
		AddAwakening(0.03)
		return
	end

	target.Status = { Type = statusType, Duration = duration }
	AppendLog("Inflicted " .. Colorize(statusType, statusType) .. "!")
	AddAwakening(0.03)
end

-- ==========================================
-- GDD 5.2: FULL DAMAGE CALCULATION PIPELINE
-- ==========================================
local function CalculateDodge(attacker, defender)
	if not attacker or not defender then return false end
	local dodgeChance = 5 + math.max(0, (defender.Stats.AGI - attacker.Stats.AGI) / 5)
	-- HighDodge buff doubles dodge chance
	if defender.Status and defender.Status.Type == "HighDodge" then dodgeChance = dodgeChance * 2 end
	if defender.Status and defender.Status.Type == "DodgeUp" then dodgeChance = dodgeChance * 1.5 end
	-- Flight gives +25% dodge (High-End Nomu Phase 2)
	if defender.HasFlight then dodgeChance = dodgeChance + 25 end
	return math.random(1, 100) <= math.clamp(dodgeChance, 5, 50)
end

local function ProcessDamage(attacker, target, rawDamage, moveData, isCrit)
	if not target then return 0 end

	-- Step 3: Offensive Multipliers (GDD 5.2)
	local modifiedDamage = rawDamage
	if isCrit then modifiedDamage = modifiedDamage * 1.5 end

	-- Gear damage bonus (e.g. Cooling Vents +5%, Homing Lens +5%)
	if attacker.DmgBonus and attacker.DmgBonus > 0 then
		modifiedDamage = modifiedDamage * (1 + attacker.DmgBonus)
	end

	-- Brittle on target = +50% (GDD 5.3)
	if target.Status and target.Status.Type == "Brittle" then
		modifiedDamage = modifiedDamage * 1.5
		AppendLog(Colorize("Brittle bonus! (+50%)", "Brittle"))
	end

	-- Bleed bonus for multi-hit/knife moves
	if target.BleedStacks and target.BleedStacks > 0 and moveData and moveData.Type == "Style" then
		local bleedBonus = 1 + (target.BleedStacks * 0.10)
		modifiedDamage = modifiedDamage * bleedBonus
	end

	-- Boss Phase 3 desperation: +25% damage (GDD 6.3.2)
	if attacker.DesperationMode then
		modifiedDamage = modifiedDamage * 1.25
	end

	-- Weaken debuff on attacker: -30% damage
	if attacker.Status and attacker.Status.Type == "Weaken" then
		modifiedDamage = modifiedDamage * 0.7
	end

	-- FocusAim buff: 3x damage on next hit
	if attacker.Status and attacker.Status.Type == "FocusAim" then
		modifiedDamage = modifiedDamage * 3.0
		attacker.Status = { Type = "Normal", Duration = 0 }
		AppendLog(Colorize("FOCUSED SHOT! (3x)", "FocusAim"))
	end

	-- Step 5: Defensive Mitigation (GDD 5.2)
	-- Some moves (Permeation, Zantetsuken, Entropy Wave) bypass armor entirely
	local armorValue = 0
	if not target._ignoreArmor then
		local corrodeReduction = (target.CorrodeStacks or 0) * 8 -- -8% defense per stack
		local effectiveEND = math.max(0, target.Stats.END * (1 - corrodeReduction / 100))
		armorValue = effectiveEND * 0.5

		-- ArmorUp buff doubles armor
		if target.Status and target.Status.Type == "ArmorUp" then armorValue = armorValue * 2 end
		if target.Status and target.Status.Type == "Hardened" then armorValue = armorValue * 1.8 end
	else
		target._ignoreArmor = nil -- reset flag after use
	end

	-- Shield absorbs damage first
	if target.ShieldHP and target.ShieldHP > 0 then
		local absorbed = math.min(target.ShieldHP, modifiedDamage)
		target.ShieldHP = target.ShieldHP - absorbed
		modifiedDamage = modifiedDamage - absorbed
		if absorbed > 0 then AppendLog("Shield absorbed " .. math.floor(absorbed) .. "!") end
		if target.ShieldHP <= 0 then
			target.Status = { Type = "Normal", Duration = 0 }
			AppendLog("Shield broke!")
		end
	end

	-- Cap armor at 50% damage reduction max
	armorValue = math.min(armorValue, modifiedDamage * 0.5)
	local finalDamage = math.floor(math.max(1, modifiedDamage - armorValue))
	target.HP = math.clamp(target.HP - finalDamage, 0, target.MaxHP)

	return finalDamage
end

local function ExecuteAttack(attacker, target, moveData)
	if not attacker or not target then return 0 end

	-- Step 1: Base Damage (GDD 5.2)
	local rawDamage = moveData.Execute(attacker, target)
	if rawDamage <= 0 and not moveData.HasStatus then return 0 end
	if rawDamage <= 0 then return 0 end

	-- Step 2: Critical Hit Check (GDD 5.2)
	local critChance = 0.05 + (attacker.CritBonus or 0)
	local isCrit = math.random() <= critChance

	-- Step 4: Dodge Check (crits bypass dodge) (GDD 5.2)
	if not isCrit then
		if CalculateDodge(attacker, target) then
			AppendLog(target.Name .. " " .. Colorize("DODGED", "DodgeUp") .. " the attack!")
			return 0
		end
	end

	-- Steps 3+5: Process damage with modifiers and mitigation
	local finalDmg = ProcessDamage(attacker, target, rawDamage, moveData, isCrit)

	-- Step 6: Application (GDD 5.2)
	if finalDmg > 0 then
		local dmgText = tostring(math.floor(finalDmg))
		if isCrit then
			dmgText = Colorize("CRITICAL! " .. dmgText, "Stun")
			-- GDD 5.4: Getting crit = 10% awakening
			if not target.IsEnemy then AddAwakening(0.10) end
		end
		AppendLog("→ Dealt " .. dmgText .. " damage to " .. target.Name .. ".")

		-- GDD 5.4: Dealing damage = 5%, Taking damage = 8%
		if not attacker.IsEnemy then AddAwakening(0.05) end
		if not target.IsEnemy then AddAwakening(0.08) end
	end

	return finalDmg
end

-- ==========================================
-- GDD 5.3: STATUS EFFECT PROCESSING (per turn)
-- ==========================================
local function ProcessStatusEffects(entity)
	if not entity or entity.HP <= 0 then return false end

	-- Decrement stun immunity
	if entity.StunImmuneTurns and entity.StunImmuneTurns > 0 then
		entity.StunImmuneTurns = entity.StunImmuneTurns - 1
	end

	local status = entity.Status
	if not status or status.Type == "Normal" then
		-- Passive regen for bosses (e.g., Nomu)
		if entity.PassiveRegen and entity.PassiveRegen > 0 then
			-- Burn halts regen (GDD 5.3)
			if not (status and status.Type == "Burn") then
				local regenAmount = math.floor(entity.MaxHP * entity.PassiveRegen)
				HealEntity(entity, regenAmount)
				AppendLog(Colorize(entity.Name .. " regenerated!", "Shield"))
			end
		end
		return false
	end

	local skipTurn = false

	if status.Type == "Burn" then
		-- GDD 5.3: 3% Max HP/turn, halts regen
		local burnDmg = math.floor(entity.MaxHP * 0.03)
		entity.HP = math.clamp(entity.HP - burnDmg, 0, entity.MaxHP)
		AppendLog(entity.Name .. " took " .. burnDmg .. " " .. Colorize("Burn", "Burn") .. " damage!")
		-- Regen is halted while burning (checked above)

	elseif status.Type == "Bleed" then
		-- GDD 5.3: 2% Max HP + (STR*0.5) per stack per turn
		local bleedStacks = entity.BleedStacks or 1
		local bleedDmg = math.floor((entity.MaxHP * 0.02 + 25) * bleedStacks)
		entity.HP = math.clamp(entity.HP - bleedDmg, 0, entity.MaxHP)
		AppendLog(entity.Name .. " bled for " .. bleedDmg .. " " .. Colorize("(x" .. bleedStacks .. ")", "Bleed") .. "!")

	elseif status.Type == "Stun" then
		-- GDD 5.3: Skip turn, immune 1 turn after
		AppendLog(entity.Name .. " is " .. Colorize("STUNNED", "Stun") .. "!")
		skipTurn = true
		entity.StunImmuneTurns = 1

	elseif status.Type == "Erasure" then
		-- Can't use Quirk moves (handled in move validation)
		AppendLog(entity.Name .. "'s Quirk is " .. Colorize("ERASED", "Erasure") .. "!")

	elseif status.Type == "Float" then
		-- Can't use Physical/Style moves
		AppendLog(entity.Name .. " is " .. Colorize("FLOATING", "Float") .. "!")

	elseif status.Type == "Haste" then
		-- +30% speed handled in turn order calc
		-- No per-turn effect
	end

	-- Passive regen for bosses (only if not burned)
	if entity.PassiveRegen and entity.PassiveRegen > 0 and status.Type ~= "Burn" then
		local regenAmount = math.floor(entity.MaxHP * entity.PassiveRegen)
		HealEntity(entity, regenAmount)
	end

	-- Decrement duration
	status.Duration = status.Duration - 1
	if status.Duration <= 0 then
		if status.Type == "Overclock" then
			-- Engine stall: lock quirks
			entity.Status = { Type = "Erasure", Duration = 3 }
			AppendLog(Colorize(entity.Name .. "'s engine stalled!", "Erasure"))
		elseif status.Type == "Bleed" then
			entity.BleedStacks = 0
			entity.Status = { Type = "Normal", Duration = 0 }
		elseif status.Type == "Stun" then
			entity.Status = { Type = "Normal", Duration = 0 }
		else
			entity.Status = { Type = "Normal", Duration = 0 }
		end
	end

	return skipTurn
end

-- ==========================================
-- GDD 6.3.2: BOSS PHASE SYSTEM
-- ==========================================
local function CheckBossPhaseTransition(entity)
	if not entity or not entity.IsBoss or entity.HP <= 0 then return end

	local hpPercent = entity.HP / entity.MaxHP
	local currentPhase = entity.CurrentPhase or 1

	-- Phase 2 trigger at 50% HP
	if currentPhase == 1 and hpPercent <= 0.50 then
		entity.CurrentPhase = 2
		AppendLog("")
		AppendLog(Colorize("═══ PHASE 2: " .. string.upper(entity.Name) .. " IS ENRAGED! ═══", "Burn"))

		-- Swap moveset if defined
		if entity.Phase2Moves then
			entity.EquippedMoves = entity.Phase2Moves
		end

		-- Execute phase script
		local script = entity.Phase2Script
		if script == "selfbuff_burn" then
			-- Bakugo: Buff self, AoE burn
			ApplyStatus(entity, "Haste", 3)
			AppendLog(Colorize(entity.Name .. " is moving faster!", "Haste"))

		elseif script == "nomu_regen" then
			-- Nomu: Regen doubles
			entity.PassiveRegen = 0.30
			AppendLog(Colorize(entity.Name .. "'s regeneration is accelerating! Use Burn to halt it!", "Bleed"))

		elseif script == "todoroki_fire" then
			-- Todoroki: Activates fire side
			AppendLog(Colorize(entity.Name .. " activated his LEFT SIDE! Fire moves unlocked!", "Burn"))

		elseif script == "highend_flight" then
			-- High-End: Gains flight (+25% dodge)
			entity.HasFlight = true
			AppendLog(Colorize(entity.Name .. " took flight! Evasion greatly increased!", "DodgeUp"))

		elseif script == "selfbuff_haste" then
			-- Stain: Speed surge
			ApplyStatus(entity, "Haste", 3)
			AppendLog(Colorize(entity.Name .. " surges with incredible speed!", "Haste"))

		elseif script == "selfbuff_str" then
			-- Rappa: Permanent strength buff (+25%)
			entity.Stats.STR = math.floor(entity.Stats.STR * 1.25)
			AppendLog(Colorize(entity.Name .. "'s strength surged! (+25%)", "Burn"))

		elseif script == "desperation" then
			-- Muscular/Generic: Early desperation mode
			entity.DesperationMode = true
			AppendLog(Colorize(entity.Name .. " is getting desperate! All attacks deal +25% damage!", "Bleed"))
		end

		-- All bosses: 10% Max HP heal on phase transition
		HealEntity(entity, math.floor(entity.MaxHP * 0.10))
	end

	-- Phase 3 trigger at 20% HP
	if currentPhase == 2 and hpPercent <= 0.20 then
		entity.CurrentPhase = 3
		AppendLog("")
		AppendLog(Colorize("═══ PHASE 3: " .. string.upper(entity.Name) .. " — DESPERATION! ═══", "Bleed"))

		-- Swap moveset
		if entity.Phase3Moves then
			entity.EquippedMoves = entity.Phase3Moves
		end

		-- All Phase 3: +25% damage (GDD 6.3.2)
		entity.DesperationMode = true

		local script = entity.Phase3Script
		if script == "desperation" then
			AppendLog(Colorize("All attacks deal +25% damage!", "Bleed"))

		elseif script == "nomu_regen_double" then
			entity.PassiveRegen = 0.45
			AppendLog(Colorize(entity.Name .. "'s regeneration is out of control! (45%/turn)", "Bleed"))

		elseif script == "highend_desperation" then
			entity.PassiveRegen = 0.16
			entity.HasFlight = true
			AppendLog(Colorize(entity.Name .. "'s regeneration doubled AND gained flight!", "Bleed"))
		end
	end
end

-- ==========================================
-- GDD 6.3.1: UTILITY-BASED ENEMY AI
-- ==========================================
local function EnemyAI(entity)
	if not entity or entity.HP <= 0 then return nil end

	-- Find player target
	local target = nil
	local lowestHPTarget = nil
	for id, data in pairs(BattleState.Combatants) do
		if not data.IsEnemy and data.HP > 0 and not data.IsDead then
			if not target then target = data end
			if not lowestHPTarget or data.HP < lowestHPTarget.HP then
				lowestHPTarget = data
			end
		end
	end
	if not target then return nil end

	-- Decrement cooldowns
	for moveId, cd in pairs(entity.Cooldowns or {}) do
		if cd > 0 then entity.Cooldowns[moveId] = cd - 1 end
	end

	-- Build scored move list
	local scoredMoves = {}
	local hpPercent = entity.HP / entity.MaxHP
	local targetHasCC = target.Status and (target.Status.Type == "Stun" or target.Status.Type == "Erasure" or target.Status.Type == "Float")
	local targetHasBrittle = target.Status and target.Status.Type == "Brittle"
	local targetHasDoT = target.Status and (target.Status.Type == "Burn" or target.Status.Type == "Bleed")

	for _, moveId in ipairs(entity.EquippedMoves) do
		local cd = (entity.Cooldowns or {})[moveId] or 0
		if cd <= 0 then
			local md = MoveDatabase[moveId]
			if md then
				-- Check if move is blocked by status
				local canUse = true
				if entity.Status and entity.Status.Type == "Erasure" and md.Type == "Quirk" then canUse = false end
				if entity.Status and entity.Status.Type == "Float" and (md.Type == "Style" or md.Type == "Basic") then canUse = false end

				if canUse then
					local score = 20 -- Default (Weight: 20)
					local rawDmg = md.Execute(entity, target)

					-- Emergency Heal (Weight: 100) — self-buff at low HP
					if hpPercent < 0.25 and (md.HasStatus and not md.IsAoE) then
						-- Check if it's a self-buff move
						local isSelfBuff = (moveId == "unmovable_stance" or moveId == "red_counter" or moveId == "evasive_spring" or moveId == "nomu_brawl" or moveId == "acid_veil")
						if isSelfBuff then score = 100 end
					end

					-- Execute (Weight: 90) — can one-shot player
					if rawDmg > 0 and target.HP > 0 then
						local estimatedDmg = math.floor(rawDmg * (entity.DesperationMode and 1.25 or 1.0))
						if estimatedDmg >= target.HP then
							score = math.max(score, 90)
						end
					end

					-- Apply CC/Debuff (Weight: 70)
					if md.HasStatus and not targetHasCC then
						local isCC = (moveId:find("stun") or moveId:find("shout") or moveId:find("trap") or moveId:find("constrict") or moveId:find("erasure") or moveId:find("float") or moveId:find("brainwash"))
						if isCC then score = math.max(score, 70) end

						-- Brittle application
						local isBrittle = (moveId:find("brittle") or moveId:find("body_blow") or moveId:find("shadow_crush") or moveId:find("luna_fall") or moveId:find("creepy_stare"))
						if isBrittle and not targetHasBrittle then score = math.max(score, 70) end
					end

					-- Exploit Debuff (Weight: 60)
					if targetHasBrittle and rawDmg > 0 then
						score = math.max(score, 60)
						-- Prefer highest damage moves when target is brittle
						score = score + math.floor(rawDmg / 100)
					end

					-- Apply DoT (Weight: 40)
					if md.HasStatus and not targetHasDoT then
						local isDoT = (moveId:find("acid") or moveId:find("burn") or moveId:find("bleed") or moveId:find("slash") or moveId:find("flame"))
						if isDoT then score = math.max(score, 40) end
					end

					-- Higher damage = slightly higher default score
					if rawDmg > 0 then score = score + math.floor(rawDmg / 200) end

					-- Boss Phase 3: heavily prioritize Execute-weight moves
					if entity.DesperationMode then
						if rawDmg > 0 then score = score + 15 end
					end

					-- Random variance ±10% (GDD 6.3.1)
					local variance = score * (math.random(-10, 10) / 100)
					score = math.floor(score + variance)

					table.insert(scoredMoves, { id = moveId, score = score, data = md })
				end
			end
		end
	end

	-- Sort by score descending, pick the best
	table.sort(scoredMoves, function(a, b) return a.score > b.score end)

	if #scoredMoves > 0 then
		return scoredMoves[1].id, scoredMoves[1].data, target
	end

	-- Fallback: basic_strike always available
	return "basic_strike", MoveDatabase["basic_strike"], target
end

