-- ==========================================
-- REMOTE EVENTS (create if missing)
-- ==========================================
local function getOrCreate(name, class)
	local existing = ReplicatedStorage:FindFirstChild(name)
	if existing then return existing end
	local inst = Instance.new(class or "RemoteEvent")
	inst.Name = name
	inst.Parent = ReplicatedStorage
	return inst
end

