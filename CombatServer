-- ==========================================

StartCombatEvent.OnServerEvent:Connect(function(player, zoneId, patrolData)
	if BattleState.IsActive then return end

	local pStats = player:FindFirstChild("PlayerStats")
	local highestZone = (pStats and pStats:FindFirstChild("HighestZoneCleared")) and pStats.HighestZoneCleared.Value or 0
	local isGauntlet = (zoneId == "1" and highestZone < 1) and not patrolData -- patrol is NEVER gauntlet

	-- Reset battle state
	BattleState.IsActive = true
	BattleState.Result = nil
	BattleState.CurrentLog = ""
	BattleState.Combatants = {}
	BattleState.IsGauntlet = isGauntlet
	BattleState.ZoneId = zoneId
	BattleState.Wave = 1
	BattleState.ExamPoints = 0
	BattleState.AccumulatedRewards = { HeroCoins=0, TrainingXP=0, Spins=0, MasteryXP=0 }
	BattleState.StartTime = os.time()
	BattleState.ZeroPointerSpawned = false
	BattleState.AwakeningMeter = 0
	BattleState.TurnCount = 0

	-- Build player entity
	local playerMoves = {}
	if pStats then
		for i = 1, 4 do
			local slotVal = pStats:FindFirstChild("MoveSlot" .. i)
			if slotVal and slotVal.Value ~= "" and slotVal.Value ~= "Empty" then
				table.insert(playerMoves, slotVal.Value)
			end
		end
	end
	if #playerMoves == 0 then table.insert(playerMoves, "basic_strike") end

	-- ═══ GDD 5.2: STAT SCALING ═══
	-- Stats are stored as LEVELS (1, 2, 3...). Convert to combat power.
	-- Formula: CombatStat = BasePower + (Level * ScalePerLevel)
	-- Every single level up gives an immediate, noticeable damage increase.
	local function scaleStat(statName, level)
		local scaling = {
			Strength     = {base = 15, perLevel = 8},   -- Lv1=23, Lv5=55, Lv10=95, Lv50=415
			Agility      = {base = 15, perLevel = 8},   -- Lv1=23, Lv5=55, Lv10=95, Lv50=415
			Endurance    = {base = 10, perLevel = 5},    -- Lv1=15, Lv5=35, Lv10=60, Lv50=260
			Intelligence = {base = 5,  perLevel = 3},    -- Lv1=8,  Lv5=20, Lv10=35, Lv50=155
			QuirkFactor  = {base = 15, perLevel = 10},   -- Lv1=25, Lv5=65, Lv10=115,Lv50=515
		}
		local s = scaling[statName] or {base = 10, perLevel = 5}
		return s.base + (level * s.perLevel)
	end

	local strLevel = (pStats and pStats:FindFirstChild("Strength")) and pStats.Strength.Value or 1
	local agiLevel = (pStats and pStats:FindFirstChild("Agility")) and pStats.Agility.Value or 1
	local endLevel = (pStats and pStats:FindFirstChild("Endurance")) and pStats.Endurance.Value or 1
	local intLevel = (pStats and pStats:FindFirstChild("Intelligence")) and pStats.Intelligence.Value or 1
	local qfLevel  = (pStats and pStats:FindFirstChild("QuirkFactor")) and pStats.QuirkFactor.Value or 1

	-- Rebirth multiplier (GDD 10.2.4: stats grow faster after rebirth)
	local rebirthCount = 0
	local rb = player:FindFirstChild("leaderstats")
	if rb then
		local rv = rb:FindFirstChild("Rebirths")
		if rv then rebirthCount = rv.Value end
	end
	local rebirthStatBonus = 1 + (rebirthCount * 0.15) -- +15% combat power per rebirth

	local baseSTR = math.floor(scaleStat("Strength", strLevel) * rebirthStatBonus)
	local baseAGI = math.floor(scaleStat("Agility", agiLevel) * rebirthStatBonus)
	local baseEND = math.floor(scaleStat("Endurance", endLevel) * rebirthStatBonus)
	local baseINT = math.floor(scaleStat("Intelligence", intLevel) * rebirthStatBonus)
	local baseQF  = math.floor(scaleStat("QuirkFactor", qfLevel) * rebirthStatBonus)

	local finalStats = { STR=baseSTR, AGI=baseAGI, END=baseEND, QF=baseQF, INT=baseINT }
	local critBonus = 0
	local dmgBonus = 0

	-- Apply gear bonuses
	if pStats then
		for _, gType in ipairs({"WEAPON", "ARMOR", "ASSIST"}) do
			local gVal = pStats:FindFirstChild("Gear" .. gType)
			if gVal and gVal.Value ~= "" and GearDatabase[gVal.Value] then
				local gear = GearDatabase[gVal.Value]
				finalStats.STR = finalStats.STR + gear.Stats.STR
				finalStats.AGI = finalStats.AGI + gear.Stats.AGI
				finalStats.END = finalStats.END + gear.Stats.END
				finalStats.QF  = finalStats.QF + (gear.Stats.QF or 0)
				critBonus = critBonus + (gear.CritBonus or 0)
				dmgBonus = dmgBonus + (gear.DmgBonus or 0)
			end
		end
	end

	local finalMaxHP = 500 + (finalStats.END * 8) -- Scales meaningfully: Lv1=620, Lv10=980, Lv50=2580

	BattleState.Combatants[player.Name] = {
		Id = player.Name, Name = player.Name,
		IsEnemy = false, IsDead = false,
		HP = finalMaxHP, MaxHP = finalMaxHP,
		Status = { Type = "Normal", Duration = 0 },
		Portrait = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. player.UserId .. "&width=150&height=150&format=png",
		Stats = finalStats,
		EquippedMoves = playerMoves,
		Cooldowns = {},
		CritBonus = critBonus,
		DmgBonus = dmgBonus,
		CorrodeStacks = 0,
		BleedStacks = 0,
	}

	-- Show player their combat power so they know stats are working
	AppendLog(Colorize("Your Stats:", "Stun") .. " STR:" .. finalStats.STR .. " AGI:" .. finalStats.AGI .. " END:" .. finalStats.END .. " QF:" .. finalStats.QF .. " INT:" .. finalStats.INT .. " HP:" .. finalMaxHP)

	-- Track patrol raid waves
	BattleState.IsPatrolRaid = false
	BattleState.PatrolRaidWave = 0
	BattleState.PatrolRaidMaxWaves = 0

	-- Spawn enemies
	if patrolData and patrolData.patrolEnemyKey then
		-- ═══ PATROL COMBAT: Spawn patrol-specific enemies ═══
		local mapEntry = PatrolEnemyMap[patrolData.patrolEnemyKey]
		local enemyKeys = {}

		if type(mapEntry) == "function" then
			enemyKeys = mapEntry() -- call the pool function for random selection
		elseif type(mapEntry) == "table" then
			enemyKeys = mapEntry
		else
			enemyKeys = {"Purse_Snatcher"}
		end

		-- Check if this is a mini-raid (multi-wave)
		if patrolData.patrolEnemyKey:find("MiniRaid") then
			BattleState.IsPatrolRaid = true
			BattleState.PatrolRaidWave = 1
			BattleState.PatrolRaidMaxWaves = 3
		end

		AppendLog(Colorize("═══ PATROL ENCOUNTER ═══", "Stun"))
		AppendLog(patrolData.encounterTitle or "A villain appears!")
		if BattleState.IsPatrolRaid then
			AppendLog(Colorize("── WAVE 1 of " .. BattleState.PatrolRaidMaxWaves .. " ──", "Burn"))
		end

		for i, eKey in ipairs(enemyKeys) do
			local template = EnemyTemplates[eKey]
			if template then
				local eId = "Enemy_" .. i .. "_" .. math.random(1000,9999)
				BattleState.Combatants[eId] = {
					Id=eId, Name=template.Name, IsEnemy=true, IsDead=false,
					HP=template.HP, MaxHP=template.HP, Status={Type="Normal",Duration=0},
					Portrait=template.Portrait, Stats=table.clone(template.Stats),
					EquippedMoves=table.clone(template.Moves), Cooldowns={},
					Rewards=template.Rewards, IsBoss=template.IsBoss or false,
					CurrentPhase=1, CorrodeStacks=0, BleedStacks=0,
					Tier=template.Tier or 1, PassiveRegen=template.PassiveRegen,
					Phase2Moves=template.Phase2Moves, Phase3Moves=template.Phase3Moves,
					Phase2Script=template.Phase2Script, Phase3Script=template.Phase3Script,
				}
				AppendLog("Enemy: " .. Colorize(template.Name, "Burn") .. " — HP: " .. template.HP)
			end
		end
	elseif isGauntlet then
		AppendLog(Colorize("═══ U.A. ENTRANCE EXAM ═══", "Stun"))
		AppendLog("Accumulate 50+ Villain Points in 10 minutes!")
		SpawnWave()
	else
		-- Spawn zone boss
		local bossKey = ZoneBossMap[tostring(zoneId)]
		if bossKey and EnemyTemplates[bossKey] then
			local template = EnemyTemplates[bossKey]
			local bId = "Boss_" .. bossKey
			BattleState.Combatants[bId] = {
				Id=bId, Name=template.Name, IsEnemy=true, IsDead=false,
				HP=template.HP, MaxHP=template.HP, Status={Type="Normal",Duration=0},
				Portrait=template.Portrait, Stats=table.clone(template.Stats),
				EquippedMoves=table.clone(template.Moves), Cooldowns={},
				Points=template.Points or 0, Rewards=template.Rewards, IsBoss=true,
				CurrentPhase=1, CorrodeStacks=0, BleedStacks=0,
				PassiveRegen=template.PassiveRegen,
				Phase2Moves=template.Phase2Moves, Phase3Moves=template.Phase3Moves,
				Phase2Script=template.Phase2Script, Phase3Script=template.Phase3Script,
				DesperationMode=false, HasFlight=false,
			}
			AppendLog(Colorize("═══ BOSS BATTLE: " .. template.Name .. " ═══", "Burn"))
		else
			-- Fallback: spawn random zone enemies
			local pool = ZoneEnemyPool[tostring(zoneId)] or {"1-Pointer"}
			local eKey = pool[math.random(1, #pool)]
			local template = EnemyTemplates[eKey]
			BattleState.Combatants["Enemy_1"] = {
				Id="Enemy_1", Name=template.Name, IsEnemy=true, IsDead=false,
				HP=template.HP, MaxHP=template.HP, Status={Type="Normal",Duration=0},
				Portrait=template.Portrait, Stats=table.clone(template.Stats),
				EquippedMoves=template.Moves, Cooldowns={},
				Rewards=template.Rewards, CurrentPhase=1,
				CorrodeStacks=0, BleedStacks=0,
			}
		end
	end

	CalculateTurnQueue()
	NextTurn()
end)

