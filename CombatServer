		table.insert(enemies, PatrolTierPools[3][math.random(1, #PatrolTierPools[3])])
		return enemies
	end,
}


local function ProcessDeaths()
	for id, data in pairs(BattleState.Combatants) do
		if data.HP <= 0 and not data.IsDead then
			data.IsDead = true
			if data.IsEnemy then
				BattleState.ExamPoints = BattleState.ExamPoints + (data.Points or 0)
				if data.Rewards then
					for k, v in pairs(data.Rewards) do
						BattleState.AccumulatedRewards[k] = (BattleState.AccumulatedRewards[k] or 0) + v
					end
				end
				AppendLog(Colorize(data.Name .. " destroyed!" .. (data.Points and data.Points > 0 and " (+" .. data.Points .. " Pts)" or ""), "Stun"))

				-- Tier-based loot drop
				local tier = data.Tier or (data.IsBoss and 4 or 1)
				local loot = RollLoot(tier)
				if loot then
					local lootStr = ""
					for k, v in pairs(loot) do
						BattleState.AccumulatedRewards[k] = (BattleState.AccumulatedRewards[k] or 0) + v
						lootStr = lootStr .. "+" .. v .. " " .. k .. " "
					end
					local rarityLabel = tier >= 4 and "LEGENDARY DROP" or tier >= 3 and "RARE DROP" or tier >= 2 and "LOOT DROP" or "DROP"
					AppendLog(Colorize("★ " .. rarityLabel .. ": " .. lootStr, tier >= 3 and "Brittle" or "Stun"))
				end

				-- Boss guaranteed gear drop
				if data.IsBoss and math.random(1,100) <= 40 then
					BattleState.AccumulatedRewards["SupportGearBox"] = (BattleState.AccumulatedRewards["SupportGearBox"] or 0) + 1
					AppendLog(Colorize("★★ SUPPORT GEAR BOX dropped!", "Brittle"))
				end
			else
				AppendLog(Colorize(data.Name .. " was knocked out!", "Bleed"))
			end
		end
	end
end

