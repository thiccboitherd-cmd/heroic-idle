-- TURN ORDER + BROADCAST
-- ==========================================
local function CalculateTurnQueue()
	local sorted = {}
	for id, data in pairs(BattleState.Combatants) do
		if data.HP > 0 and not data.IsDead then
			-- Haste buff: +30% effective AGI for turn order
			local effectiveAGI = data.Stats.AGI
			if data.Status and data.Status.Type == "Haste" then effectiveAGI = effectiveAGI * 1.3 end
			table.insert(sorted, { id = id, agi = effectiveAGI })
		end
	end
	table.sort(sorted, function(a, b) return a.agi > b.agi end)
	BattleState.TurnQueue = {}
	for _, entry in ipairs(sorted) do table.insert(BattleState.TurnQueue, entry.id) end
end

local function BroadcastState()
	local visualQueue = {}
	if BattleState.ActiveTurn ~= "" then table.insert(visualQueue, BattleState.ActiveTurn) end
	for _, id in ipairs(BattleState.TurnQueue) do table.insert(visualQueue, id) end

	local logToSend = BattleState.CurrentLog
	BattleState.CurrentLog = ""

	local clientData = {
		IsActive = BattleState.IsActive,
		TurnQueue = visualQueue,
		ActiveTurn = BattleState.ActiveTurn,
		Result = BattleState.Result,
		LogMessage = logToSend,
		Combatants = {},
		AvailableMoves = {},
		AwakeningPercent = BattleState.AwakeningMeter,
	}

	for id, data in pairs(BattleState.Combatants) do
		if not data.IsDead then
			clientData.Combatants[id] = {
				Name = data.Name, IsEnemy = data.IsEnemy,
				HP = data.HP, MaxHP = data.MaxHP,
				Status = data.Status, Portrait = data.Portrait,
				IsBoss = data.IsBoss,
				CurrentPhase = data.CurrentPhase, -- for client phase indicator
			}
		end
	end

	-- Build available moves for the active player
	local activeEntity = BattleState.Combatants[BattleState.ActiveTurn]
	if activeEntity and not activeEntity.IsEnemy then
		-- INT reduces cooldowns (GDD 3.2.4)
		local intReduction = math.floor((activeEntity.Stats.INT or 0) / 50) -- -1 CD per 50 INT

		for _, moveId in ipairs(activeEntity.EquippedMoves) do
			local md = MoveDatabase[moveId]
			if md then
				local state = "Normal"
				local remainingCD = (activeEntity.Cooldowns[moveId] or 0)

				-- Check if blocked by status
				if activeEntity.Status and activeEntity.Status.Type == "Erasure" and md.Type == "Quirk" then state = "Erasure" end
				if activeEntity.Status and activeEntity.Status.Type == "Float" and (md.Type == "Style" or md.Type == "Basic") then state = "Erasure" end

				-- On cooldown
				if remainingCD > 0 then state = "Cooldown" end

				local cdText = ""
				if remainingCD > 0 then cdText = " [" .. remainingCD .. " turns]" end

				table.insert(clientData.AvailableMoves, {
					Id = moveId, Name = md.Name .. cdText,
					Type = md.Type, Desc = md.Desc,
					IsQuirk = (md.Type == "Quirk"), State = state,
				})
			end
		end
	end

	CombatUpdateEvent:FireAllClients(clientData)
end

