	local pool = PatrolTierPools[tier] or PatrolTierPools[1]
	local result = {}
	for i = 1, count do
		result[i] = pool[math.random(1, #pool)]
	end
	return result
end

-- Map encounter titles to dynamic spawning
local PatrolEnemyMap = {
	-- 1★: Single weak enemy
	["Purse_Snatcher"]  = function() return pickRandomFromPool(1, 1) end,
