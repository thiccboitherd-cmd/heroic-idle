-- PLAYER COMBAT ACTION HANDLER
-- ==========================================
CombatActionEvent.OnServerEvent:Connect(function(player, moveId, targetId)
	if not BattleState.IsActive then return end
	if BattleState.ActiveTurn ~= player.Name then return end

	local user = BattleState.Combatants[player.Name]
	local moveData = MoveDatabase[moveId]
	local primaryTarget = BattleState.Combatants[targetId]

	if not user or not moveData then return end

	-- Validate status blocks
	if user.Status and user.Status.Type == "Erasure" and moveData.Type == "Quirk" then return end
	if user.Status and user.Status.Type == "Float" and (moveData.Type == "Style" or moveData.Type == "Basic") then return end

	-- Validate cooldown
	local cd = (user.Cooldowns or {})[moveId] or 0
	if cd > 0 then return end

	BattleState.ActiveTurn = "Processing"

	-- Set cooldown (INT reduces CDs — GDD 3.2.4)
	user.Cooldowns = user.Cooldowns or {}
	local intReduction = math.floor((user.Stats.INT or 0) / 50)
	user.Cooldowns[moveId] = math.max(0, (moveData.BaseCD or 0) - intReduction)

	if moveData.IsAoE then
		AppendLog(user.Name .. " used AoE: " .. Colorize(moveData.Name, "Stun") .. "!")
		for id, data in pairs(BattleState.Combatants) do
			if data.IsEnemy and data.HP > 0 and not data.IsDead then
				ExecuteAttack(user, data, moveData)
			end
		end
	elseif primaryTarget and primaryTarget.IsEnemy and primaryTarget.HP > 0 and not primaryTarget.IsDead then
		AppendLog(user.Name .. " used " .. Colorize(moveData.Name, "Stun") .. " on " .. primaryTarget.Name .. "!")
		ExecuteAttack(user, primaryTarget, moveData)
	else
		BattleState.ActiveTurn = player.Name
		return
	end

	-- Check boss phases after player attack
	for _, data in pairs(BattleState.Combatants) do
		if data.IsBoss and data.HP > 0 then CheckBossPhaseTransition(data) end
	end

	ProcessDeaths()
	BroadcastState()
	task.wait(1)
	NextTurn()
end)

