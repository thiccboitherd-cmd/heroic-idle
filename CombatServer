local function SpawnWave()
	AppendLog(Colorize("─── WAVE " .. BattleState.Wave .. " ───", "Burn"))
	BattleState.Wave = BattleState.Wave + 1
	for id, data in pairs(BattleState.Combatants) do
		if data.IsEnemy then BattleState.Combatants[id] = nil end
	end
	local numEnemies = math.random(1, 3)
	for i = 1, numEnemies do
		local roll = math.random(1, 100)
		local eType = roll <= 50 and "1-Pointer" or roll <= 80 and "2-Pointer" or roll <= 95 and "3-Pointer" or roll <= 99 and "0-Pointer" or "Present Mic"
		local template = EnemyTemplates[eType]
		local eId = "Enemy_" .. i .. "_" .. math.random(1000,9999)
		BattleState.Combatants[eId] = {
			Id=eId, Name=template.Name, IsEnemy=true, IsDead=false,
			HP=template.HP, MaxHP=template.HP, Status={Type="Normal",Duration=0},
			Portrait=template.Portrait, Stats=table.clone(template.Stats),
			EquippedMoves=template.Moves, Cooldowns={},
			Points=template.Points, Rewards=template.Rewards, IsBoss=template.IsBoss,
			CurrentPhase=1, CorrodeStacks=0, BleedStacks=0,
			PassiveRegen=template.PassiveRegen,
			Phase2Moves=template.Phase2Moves, Phase3Moves=template.Phase3Moves,
			Phase2Script=template.Phase2Script, Phase3Script=template.Phase3Script,
		}
	end
end

-- Patrol Raid wave spawning (uses dynamic pools, not exam enemies)
local function SpawnPatrolRaidWave()
	BattleState.PatrolRaidWave = BattleState.PatrolRaidWave + 1
	local wave = BattleState.PatrolRaidWave

	-- Clear dead enemies
	for id, data in pairs(BattleState.Combatants) do
		if data.IsEnemy then BattleState.Combatants[id] = nil end
	end

	AppendLog(Colorize("── WAVE " .. wave .. " of " .. BattleState.PatrolRaidMaxWaves .. " ──", "Burn"))

	-- Scale enemies per wave
	local waveKey = "MiniRaid_Wave" .. math.min(wave, 3)
	local mapEntry = PatrolEnemyMap[waveKey]
	local enemyKeys = type(mapEntry) == "function" and mapEntry() or {"Raid_Grunt","Raid_Grunt"}

	for i, eKey in ipairs(enemyKeys) do
		local template = EnemyTemplates[eKey]
		if template then
			-- Scale HP slightly per wave for difficulty ramp
			local hpMult = 1 + (wave - 1) * 0.15
			local scaledHP = math.floor(template.HP * hpMult)
			local eId = "Enemy_W" .. wave .. "_" .. i .. "_" .. math.random(1000,9999)
			BattleState.Combatants[eId] = {
				Id=eId, Name=template.Name, IsEnemy=true, IsDead=false,
				HP=scaledHP, MaxHP=scaledHP, Status={Type="Normal",Duration=0},
				Portrait=template.Portrait, Stats=table.clone(template.Stats),
				EquippedMoves=table.clone(template.Moves), Cooldowns={},
				Rewards=template.Rewards, IsBoss=template.IsBoss or false,
				CurrentPhase=1, CorrodeStacks=0, BleedStacks=0,
				Tier=template.Tier or 1, PassiveRegen=template.PassiveRegen,
				Phase2Moves=template.Phase2Moves, Phase3Moves=template.Phase3Moves,
				Phase2Script=template.Phase2Script, Phase3Script=template.Phase3Script,
			}
			AppendLog("Enemy: " .. Colorize(template.Name, "Burn") .. " — HP: " .. scaledHP)
		end
	end

	CalculateTurnQueue()
end

local function EvaluateGauntlet()
	BattleState.IsActive = false
	if BattleState.ExamPoints >= 50 then
		local bonusMult = BattleState.ExamPoints > 76 and 2 or 1
		local title = bonusMult == 2 and "NUMBER 1 EXAMINEE! (2X REWARDS)" or "EXAM PASSED!"
		for k, v in pairs(BattleState.AccumulatedRewards) do
			BattleState.AccumulatedRewards[k] = v * bonusMult
		end
		AppendLog(Colorize(title .. " Points: " .. BattleState.ExamPoints, "Stun"))
		BattleState.Result = { Type = "Victory", Rewards = BattleState.AccumulatedRewards }
		-- Unlock zone progression
		for id, data in pairs(BattleState.Combatants) do
			if not data.IsEnemy then
				local plr = Players:FindFirstChild(id)
				if plr and plr:FindFirstChild("PlayerStats") then
					local hz = plr.PlayerStats:FindFirstChild("HighestZoneCleared")
					if not hz then hz = Instance.new("IntValue", plr.PlayerStats); hz.Name = "HighestZoneCleared" end
					if hz.Value < 1 then hz.Value = 1 end
				end
			end
		end
	else
		AppendLog(Colorize("EXAM FAILED. " .. BattleState.ExamPoints .. "/50 points.", "Bleed"))
		BattleState.Result = { Type = "Defeat", Rewards = BattleState.AccumulatedRewards }
	end
	AwardRewards()
end

local function CheckBattleEnd()
	ProcessDeaths()
	-- Gauntlet timer check
	if BattleState.IsGauntlet then
		if os.time() - BattleState.StartTime >= 600 then
			AppendLog(Colorize("BUZZER! 10 minutes is up!", "Stun"))
			EvaluateGauntlet()
			return true
		end
	end
	local playersAlive, enemiesAlive = false, false
	for _, data in pairs(BattleState.Combatants) do
		if not data.IsDead then
			if data.IsEnemy then enemiesAlive = true else playersAlive = true end
		end
	end
	if not playersAlive then
		if BattleState.IsGauntlet then EvaluateGauntlet()
		else
			BattleState.IsActive = false
			BattleState.Result = { Type = "Defeat", Rewards = BattleState.AccumulatedRewards }
			AwardRewards()
		end
		return true
	elseif not enemiesAlive then
		if BattleState.IsGauntlet then SpawnWave(); return false
		elseif BattleState.IsPatrolRaid and BattleState.PatrolRaidWave < BattleState.PatrolRaidMaxWaves then
			-- Patrol raid: spawn next wave
			AppendLog(Colorize("Wave cleared!", "Stun"))
			SpawnPatrolRaidWave()
			return false
		else
			BattleState.IsActive = false
			if BattleState.IsPatrolRaid then
				AppendLog(Colorize("═══ MINI-RAID COMPLETE! All waves cleared! ═══", "Stun"))
			end
			BattleState.Result = { Type = "Victory", Rewards = BattleState.AccumulatedRewards }
			AwardRewards()
			return true
		end
	end
	return false
end

-- ==========================================
-- CORE TURN LOOP
-- ==========================================
local function NextTurn()
	if not BattleState.IsActive then return end
	if CheckBattleEnd() then BroadcastState(); return end

	BattleState.TurnCount = BattleState.TurnCount + 1

	-- Zero-Pointer spawn at 8 min (gauntlet)
	if BattleState.IsGauntlet and not BattleState.ZeroPointerSpawned then
		if os.time() - BattleState.StartTime >= 480 then
			BattleState.ZeroPointerSpawned = true
			AppendLog(Colorize("⚠ WARNING: ZERO-POINTER DETECTED! 2 MINUTES REMAINING!", "Bleed"))
			local template = EnemyTemplates["0-Pointer"]
			local eId = "Enemy_Zero_" .. math.random(1000,9999)
			BattleState.Combatants[eId] = {
				Id=eId, Name=template.Name, IsEnemy=true, IsDead=false,
				HP=template.HP, MaxHP=template.HP, Status={Type="Normal",Duration=0},
				Portrait=template.Portrait, Stats=table.clone(template.Stats),
				EquippedMoves=template.Moves, Cooldowns={},
				Points=template.Points, Rewards=template.Rewards, IsBoss=template.IsBoss,
				CurrentPhase=1, CorrodeStacks=0, BleedStacks=0,
			}
			CalculateTurnQueue()
		end
	end

	if #BattleState.TurnQueue == 0 then CalculateTurnQueue() end

	BattleState.ActiveTurn = table.remove(BattleState.TurnQueue, 1)
	local activeEntity = BattleState.Combatants[BattleState.ActiveTurn]
	if not activeEntity or activeEntity.HP <= 0 or activeEntity.IsDead then NextTurn(); return end

	-- Process status effects at start of turn
	local skipTurn = ProcessStatusEffects(activeEntity)
	if activeEntity.HP <= 0 then NextTurn(); return end

	-- Check boss phase transitions (GDD 6.3.2)
	if activeEntity.IsBoss then CheckBossPhaseTransition(activeEntity) end

	-- If player turn: broadcast and wait for input
	if not activeEntity.IsEnemy then
		-- Decrement player cooldowns
		for moveId, cd in pairs(activeEntity.Cooldowns or {}) do
			if cd > 0 then activeEntity.Cooldowns[moveId] = cd - 1 end
		end
		BroadcastState()
		if skipTurn then
			task.wait(1.5)
			BroadcastState()
			NextTurn()
		end
		return -- Wait for CombatActionEvent
	end

	-- ENEMY TURN (GDD 6.3.1 Utility AI)
	if skipTurn then
		task.wait(1.5)
		BroadcastState()
		NextTurn()
		return
	end

	task.wait(1.5)

	local chosenMoveId, chosenMoveData, target = EnemyAI(activeEntity)

	if chosenMoveId and chosenMoveData and target then
		activeEntity.Cooldowns = activeEntity.Cooldowns or {}
		activeEntity.Cooldowns[chosenMoveId] = chosenMoveData.BaseCD or 0

		AppendLog(activeEntity.Name .. " used " .. Colorize(chosenMoveData.Name, activeEntity.IsBoss and "Burn" or "Bleed") .. "!")

		if chosenMoveData.IsAoE then
			for id, data in pairs(BattleState.Combatants) do
				if not data.IsEnemy and data.HP > 0 and not data.IsDead then
					ExecuteAttack(activeEntity, data, chosenMoveData)
				end
			end
		else
			ExecuteAttack(activeEntity, target, chosenMoveData)
		end
	else
		AppendLog(activeEntity.Name .. " couldn't use any moves!")
	end

	-- Check boss phases after attack
	for _, data in pairs(BattleState.Combatants) do
		if data.IsBoss and data.HP > 0 then CheckBossPhaseTransition(data) end
	end

	ProcessDeaths()
	BroadcastState()
	task.wait(1)
	NextTurn()
end

